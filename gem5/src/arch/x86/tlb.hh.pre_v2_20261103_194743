#ifndef __ARCH_X86_TLB_HH__
#define __ARCH_X86_TLB_HH__

#include <list>
#include <vector>

#include "arch/generic/tlb.hh"
#include "arch/x86/pagetable.hh"
#include "base/trie.hh"
#include "mem/request.hh"
#include "params/X86TLB.hh"
#include "sim/stats.hh"

namespace gem5
{

class ThreadContext;

namespace X86ISA
{
    class Walker;

    class TLB : public BaseTLB
    {
      protected:
        friend class Walker;

        typedef std::list<TlbEntry *> EntryList;

        uint32_t configAddress;

      public:

        typedef X86TLBParams Params;
        TLB(const Params &p);

        void takeOverFrom(BaseTLB *otlb) override {}

        TlbEntry *lookup(Addr va, bool update_lru = true);

        void setConfigAddress(uint32_t addr);
        //concatenate Page Addr and pcid
        inline Addr concAddrPcid(Addr vpn, uint64_t pcid)
        {
          return (vpn | pcid);
        }

      protected:

        EntryList::iterator lookupIt(Addr va, bool update_lru = true);

        Walker * walker;

      public:
        Walker *getWalker();

        void flushAll() override;

        void flushNonGlobal();

        void demapPage(Addr va, uint64_t asn) override;

      protected:
        uint32_t size;
        std::vector<TlbEntry> tlb;
        EntryList freeList;
        TlbEntryTrie trie;
        uint64_t lruSeq;

        // --- PERFORATED PAGES (ISCA 2020) L2 ARCHITECTURE ---
        static const uint32_t L2_SETS = 128;
        static const uint32_t L2_WAYS = 4;

        static const uint8_t COARSE_EMPTY = 0; // Chunk has no valid sub-pages
        static const uint8_t COARSE_CLEAN = 1; // Chunk has all 64 pages valid (no holes)
        static const uint8_t COARSE_HOLEY = 2; // Chunk has holes (mixed valid/holes)

        // Entry types in Unified L2 TLB (ISCA 2020 Section IV-C)
        enum L2EntryType {
            L2_TYPE_EMPTY = 0,
            L2_TYPE_TRANSLATION = 1, // Regular / Perforated large page mapping
            L2_TYPE_BITMAP = 2       // Decoupled 32-bit hole bitmap cache line
        };

        struct DecoupledBitmapLine {
            Addr vpn_2mb;
            uint8_t chunk_idx; // Chunk index (0..15) for 32-bit sub-bitmaps
            uint32_t bitmap_bits; // 32 bits for 32 sub-pages
            uint64_t lruSeq;
            uint64_t pcid;
            bool global;

            DecoupledBitmapLine() : vpn_2mb(0), chunk_idx(0), bitmap_bits(0),
                lruSeq(0), pcid(0), global(false) {}
        };

        struct SparseL2Entry {
            Addr vpn_2mb;
            uint64_t pcid;
            bool global;
            uint64_t lruSeq;
            Addr paddrs[512];
            bool sub_valid[512];
            bool uncacheable[512];
            bool read_only[512];
            uint8_t coarse_filter[8]; // 8-bit coarse filter in PTE

            SparseL2Entry() : vpn_2mb(0), pcid(0), global(false), lruSeq(0) {
                for (int i = 0; i < 512; i++) {
                    sub_valid[i] = false;
                    paddrs[i] = 0;
                    uncacheable[i] = false;
                    read_only[i] = false;
                }
                for (int i = 0; i < 8; i++) {
                    coarse_filter[i] = COARSE_EMPTY;
                }
            }
        };

        // --- GRAND HYBRID: CoLT-FA Buffer (MICRO 2012) ---
        static const uint32_t COLT_FA_ENTRIES = 8;
        struct ColtFaEntry {
            Addr vpn_base;          // base VPN (page-aligned, unconcatenated)
            Addr paddr_base;        // base physical address
            uint8_t coal_len;       // number of contiguous pages coalesced (1 to 8)
            uint64_t lruSeq;
            uint64_t pcid;
            bool valid;
            bool global;
            bool uncacheable;
            bool read_only;
        };
        ColtFaEntry colt_fa_array[COLT_FA_ENTRIES];
        uint64_t colt_fa_lruSeq;
        TlbEntry temp_colt_entry;

        TlbEntry *colt_fa_lookup(Addr va, uint64_t pcid, bool update_lru = true);
        void colt_fa_insert(Addr base_vpn, Addr base_paddr, uint8_t coal_len,
                            bool uncacheable, bool read_only,
                            uint64_t pcid, bool global);

        struct UnifiedL2Way {
            L2EntryType type;
            SparseL2Entry trans;
            DecoupledBitmapLine bmp;
            uint64_t lruSeq;

            UnifiedL2Way() : type(L2_TYPE_EMPTY), lruSeq(0) {}
        };

        struct L2Set {
            UnifiedL2Way ways[L2_WAYS];
        };

        std::vector<L2Set> l2_sets;

        // Decoupled bitmap cache helpers
        bool probe_bitmap_cache(Addr vpn_2mb, uint8_t chunk_idx, uint64_t pcid,
                                uint32_t *cached_bits = nullptr);
        void install_bitmap_cache(Addr vpn_2mb, uint8_t chunk_idx,
                                  uint32_t bits, uint64_t pcid, bool global);
        uint64_t l2_lruSeq;
        TlbEntry temp_shp_entry;

        inline uint32_t xor_7_hash(Addr vpn) {
            uint32_t hi = (vpn >> 7) & 0x7F;
            uint32_t lo = vpn & 0x7F;
            return hi ^ lo;
        }

        // --- ADD L2 HELPER FUNCTIONS ---
        TlbEntry *l2_lookup(Addr va, uint64_t pcid, bool update_lru = true);
        TlbEntry *l2_insert(Addr vpn, const TlbEntry &entry, uint64_t pcid);
        void l2_remove(Addr va, uint64_t asn = 0);

        AddrRange m5opRange;

        struct TlbStats : public statistics::Group
        {
            TlbStats(statistics::Group *parent);

            statistics::Scalar rdAccesses;
            statistics::Scalar wrAccesses;
            statistics::Scalar exAccesses;
            statistics::Scalar rdMisses;
            statistics::Scalar wrMisses;
            statistics::Scalar exMisses;

            // Perforated Pages (ISCA 2020) Statistics
            statistics::Scalar coarseFilterLookups;
            statistics::Scalar coarseFilterCleanHits;
            statistics::Scalar coarseFilterEarlyRejects;
            statistics::Scalar secondaryBitmapAccesses;
            statistics::Scalar l2BitmapHits;
            statistics::Scalar l2BitmapHoleMisses;
            statistics::Scalar estLookupCyclesSaved;
            statistics::Scalar estDynamicEnergyUnitsSaved;
            // Decoupled In-TLB Bitmap Caching (Section IV-C)
            statistics::Scalar decoupledBitmapCacheHits;
            statistics::Scalar decoupledBitmapCacheMisses;
            statistics::Scalar decoupledBitmapInstalls;
            statistics::Scalar decoupledBitmapEvictedTranslations;
            // Grand Hybrid Statistics
            statistics::Scalar coltFaLookups;
            statistics::Scalar coltFaHits;
            statistics::Scalar l2ExclusivePromotions;
            statistics::Scalar l1EvictionsSpilledToL2;
        } stats;

        Fault translateInt(bool read, RequestPtr req, ThreadContext *tc);

        Fault translate(const RequestPtr &req, ThreadContext *tc,
                BaseMMU::Translation *translation, BaseMMU::Mode mode,
                bool &delayedResponse, bool timing);

      public:

        void evictLRU();

        uint64_t
        nextSeq()
        {
            return ++lruSeq;
        }

        Fault translateAtomic(
            const RequestPtr &req, ThreadContext *tc,
            BaseMMU::Mode mode) override;
        Fault translateFunctional(
            const RequestPtr &req, ThreadContext *tc,
            BaseMMU::Mode mode) override;
        void translateTiming(
            const RequestPtr &req, ThreadContext *tc,
            BaseMMU::Translation *translation, BaseMMU::Mode mode) override;

        /**
         * Do post-translation physical address finalization.
         *
         * Some addresses, for example requests going to the APIC,
         * need post-translation updates. Such physical addresses are
         * remapped into a "magic" part of the physical address space
         * by this method.
         *
         * @param req Request to updated in-place.
         * @param tc Thread context that created the request.
         * @param mode Request type (read/write/execute).
         * @return A fault on failure, NoFault otherwise.
         */
        Fault finalizePhysical(const RequestPtr &req, ThreadContext *tc,
                               BaseMMU::Mode mode) const override;

        TlbEntry *insert(Addr vpn, const TlbEntry &entry, uint64_t pcid);

        // Checkpointing
        void serialize(CheckpointOut &cp) const override;
        void unserialize(CheckpointIn &cp) override;

        /**
         * Get the table walker port. This is used for
         * migrating port connections during a CPU takeOverFrom()
         * call. For architectures that do not have a table walker,
         * NULL is returned, hence the use of a pointer rather than a
         * reference. For X86 this method will always return a valid
         * port pointer.
         *
         * @return A pointer to the walker port
         */
        Port *getTableWalkerPort() override;
    };

} // namespace X86ISA
} // namespace gem5

#endif // __ARCH_X86_TLB_HH__
