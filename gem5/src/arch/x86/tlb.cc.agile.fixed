namespace X86ISA {

// ===================== AGILE PREFETCHER CONFIG (env vars, see tlb.hh) =====
namespace
{

enum class PfTarget { L2, L1, SPLIT };
enum class PfPriority { MRU, LRU, LOW };
enum class PfWindow { ALIGNED, UNALIGNED };
enum class PfDir { ASC, DESC, STRIDE };
enum class PfAdaptive { OFF, EXP, ADD, AIMD };

struct PfConfig
{
    uint32_t baseDegree = 1;
    PfTarget target = PfTarget::L2;
    PfPriority priority = PfPriority::MRU;
    PfWindow window = PfWindow::ALIGNED;
    PfDir dir = PfDir::ASC;
    PfAdaptive adaptive = PfAdaptive::OFF;
    bool throttle = false;
    bool skipNonPresent = true;

    static uint32_t clampDegree(uint32_t d)
    {
        if (d >= 8) return 8;
        if (d >= 4) return 4;
        if (d >= 2) return 2;
        return 1;
    }

    PfConfig()
    {
        if (const char *s = std::getenv("AGILE_PF_DEGREE"))
            baseDegree = clampDegree((uint32_t)strtoul(s, nullptr, 0));
        if (const char *s = std::getenv("AGILE_PF_TARGET")) {
            std::string v(s);
            if (v == "l1") target = PfTarget::L1;
            else if (v == "split") target = PfTarget::SPLIT;
            else target = PfTarget::L2;
        }
        if (const char *s = std::getenv("AGILE_PF_PRIORITY")) {
            std::string v(s);
            if (v == "lru") priority = PfPriority::LRU;
            else if (v == "low") priority = PfPriority::LOW;
            else priority = PfPriority::MRU;
        }
        if (const char *s = std::getenv("AGILE_PF_WINDOW")) {
            std::string v(s);
            window = (v == "unaligned") ? PfWindow::UNALIGNED : PfWindow::ALIGNED;
        }
        if (const char *s = std::getenv("AGILE_PF_DIR")) {
            std::string v(s);
            if (v == "desc") dir = PfDir::DESC;
            else if (v == "stride") dir = PfDir::STRIDE;
            else dir = PfDir::ASC;
        }
        if (const char *s = std::getenv("AGILE_PF_ADAPTIVE")) {
            std::string v(s);
            if (v == "exp") adaptive = PfAdaptive::EXP;
            else if (v == "add") adaptive = PfAdaptive::ADD;
            else if (v == "aimd") adaptive = PfAdaptive::AIMD;
            else adaptive = PfAdaptive::OFF;
        }
        if (const char *s = std::getenv("AGILE_PF_THROTTLE"))
            throttle = atoi(s) != 0;
        if (const char *s = std::getenv("AGILE_PF_SKIP_NP"))
            skipNonPresent = atoi(s) != 0;
    }
};

PfConfig &pfCfg() { static PfConfig c; return c; }

} // anonymous namespace

TLB::TLB(const Params &p)
    : BaseTLB(p), configAddress(0), size(p.size),
      tlb(size), lruSeq(0),
      l2_lruSeq(0), // <--- SET-ASSOCIATIVE L2
      pf_degree_cur(1), pf_epoch_issued(0), pf_epoch_hits(0),
      pf_throttled(false), pf_prev_miss_vaddr(0), pf_have_prev_miss(false),
      pf_stride_pages(1), pf_window_hits(0),
      m5opRange(p.system->m5opRange()), stats(this)
{
    if (!size)
        fatal("TLBs must have a non-zero size.\n");

    for (int x = 0; x < size; x++) {
        tlb[x].trieHandle = NULL;
        freeList.push_back(&tlb[x]);
    }

    // --- SET-ASSOCIATIVE L2 SETUP ---
    l2_sets.resize(L2_SETS);
    for (int i = 0; i < L2_SETS; i++) {
        for (int j = 0; j < L2_WAYS; j++) {
            l2_sets[i].valid[j] = false;
            l2_sets[i].prefetched[j] = false;
        }
    }
    pf_degree_cur = pfCfg().baseDegree;
    // ----------------------------------------------

    walker = p.walker;
    walker->setTLB(this);
}

// --- SET-ASSOCIATIVE L2 HELPER FUNCTIONS ---
TlbEntry *TLB::l2_lookup(Addr va, bool update_lru) {
    Addr true_vpn = va >> X86ISA::PageShift;
    uint32_t set_idx = xor_7_hash(true_vpn);

    for (int i = 0; i < L2_WAYS; i++) {
        if (l2_sets[set_idx].valid[i] && l2_sets[set_idx].entries[i].vaddr == va) {
            if (update_lru) l2_sets[set_idx].entries[i].lruSeq = ++l2_lruSeq;
            return &l2_sets[set_idx].entries[i];
        }
    }
    return NULL;
}

// FIX (was missing from the naivefp snapshot, present in tlb.hh's declaration
// but never defined -> a straight link error the moment anything called it,
// and demapPage/flushNonGlobal had nothing to call to clear a stale L2 copy).
void TLB::l2_remove(Addr va) {
    Addr true_vpn = va >> X86ISA::PageShift;
    uint32_t set_idx = xor_7_hash(true_vpn);

    for (int i = 0; i < L2_WAYS; i++) {
        if (l2_sets[set_idx].valid[i] &&
            (l2_sets[set_idx].entries[i].vaddr & ~((Addr)0xFFF)) ==
            (va & ~((Addr)0xFFF))) {
            if (l2_sets[set_idx].prefetched[i])
                stats.pfEvictedUnused++;
            l2_sets[set_idx].valid[i] = false;
            l2_sets[set_idx].prefetched[i] = false;
        }
    }
}

TlbEntry *TLB::l2_insert(Addr vpn, const TlbEntry &entry, uint64_t pcid,
                         bool is_prefetch, bool low_priority) {
    uint32_t true_vpn = vpn >> X86ISA::PageShift;
    uint32_t set_idx = xor_7_hash(true_vpn);

    Addr concat_va = concAddrPcid(vpn, pcid);

    // Check if it's already there
    for (int i = 0; i < L2_WAYS; i++) {
        if (l2_sets[set_idx].valid[i] && l2_sets[set_idx].entries[i].vaddr == concat_va) {
            // Already resident: a demand install over a surviving prefetch
            // counts as that prefetch having proven useful.
            if (l2_sets[set_idx].prefetched[i] && !is_prefetch) {
                stats.pfUseful++;
                l2_sets[set_idx].prefetched[i] = false;
            }
            return &l2_sets[set_idx].entries[i];
        }
    }

    // Choose a victim way according to install priority.
    int victim_way = 0;
    bool found_empty = false;
    for (int i = 0; i < L2_WAYS; i++) {
        if (!l2_sets[set_idx].valid[i]) {
            victim_way = i;
            found_empty = true;
            break;
        }
    }
    if (!found_empty) {
        // All ways occupied: pick by LRU regardless of priority knob (a
        // real victim must be chosen); the priority knob instead controls
        // the *new* entry's resulting lruSeq below, i.e. how soon it in
        // turn becomes a victim.
        victim_way = 0;
        for (int i = 0; i < L2_WAYS; i++) {
            if (l2_sets[set_idx].entries[i].lruSeq < l2_sets[set_idx].entries[victim_way].lruSeq)
                victim_way = i;
        }
        // Count pollution: an evicted-but-never-demanded prefetch.
        if (l2_sets[set_idx].prefetched[victim_way])
            stats.pfEvictedUnused++;
    }

    l2_sets[set_idx].valid[victim_way] = true;
    l2_sets[set_idx].entries[victim_way] = entry;
    l2_sets[set_idx].entries[victim_way].vaddr = concat_va;
    l2_sets[set_idx].prefetched[victim_way] = is_prefetch;

    uint64_t newSeq;
    if (is_prefetch && low_priority) {
        // LOW priority: installed with the lowest possible sequence number
        // among currently valid entries, so it is the first picked by the
        // next LRU eviction (a losing ticket unless it is demanded first).
        newSeq = 0;
        for (int i = 0; i < L2_WAYS; i++) {
            if (i != victim_way && l2_sets[set_idx].valid[i])
                newSeq = std::min(newSeq == 0 ? l2_sets[set_idx].entries[i].lruSeq
                                               : newSeq,
                                   l2_sets[set_idx].entries[i].lruSeq);
        }
        if (newSeq > 0) newSeq -= 1;
    } else if (is_prefetch && pfCfg().priority == PfPriority::LRU) {
        newSeq = ++l2_lruSeq; // ordinary insertion sequence (ages like a demand line)
    } else {
        newSeq = ++l2_lruSeq; // MRU (default): freshest possible sequence number
    }
    l2_sets[set_idx].entries[victim_way].lruSeq = newSeq;

    return &l2_sets[set_idx].entries[victim_way];
}
// -------------------------------------------

void
TLB::evictLRU()
{
    // Find the entry with the lowest (and hence least recently updated)
    // sequence number.

    unsigned lru = 0;
    for (unsigned i = 1; i < size; i++) {
        if (tlb[i].lruSeq < tlb[lru].lruSeq)
            lru = i;
    }

    assert(tlb[lru].trieHandle);
    trie.remove(tlb[lru].trieHandle);
    tlb[lru].trieHandle = NULL;
    freeList.push_back(&tlb[lru]);
}

TlbEntry *
TLB::insert(Addr vpn, const TlbEntry &entry, uint64_t pcid)
{
    // Demand install also fills the L2 (never flagged as a prefetch, so the
    // oracle/pollution counters only ever attribute pollution to the
    // prefetcher, not to ordinary NINE-style L2 fills).
    l2_insert(vpn, entry, pcid, /*is_prefetch=*/false, /*low_priority=*/false);

    //Adding pcid to the page address so
    //that multiple processes using the same
    //tlb do not conflict when using the same
    //virtual addresses
    vpn = concAddrPcid(vpn, pcid);

    // If somebody beat us to it, just use that existing entry.
    TlbEntry *newEntry = trie.lookup(vpn);
    if (newEntry) {
        assert(newEntry->vaddr == vpn);
        return newEntry;
    }

    if (freeList.empty())
        evictLRU();

    newEntry = freeList.front();
    freeList.pop_front();

    *newEntry = entry;
    newEntry->lruSeq = nextSeq();
    newEntry->vaddr = vpn;
    if (FullSystem) {
        newEntry->trieHandle =
        trie.insert(vpn, TlbEntryTrie::MaxBits-entry.logBytes, newEntry);
    }
    else {
        newEntry->trieHandle =
        trie.insert(vpn, TlbEntryTrie::MaxBits, newEntry);
    }
    return newEntry;
}

TlbEntry *
TLB::lookup(Addr va, bool update_lru)
{
    TlbEntry *entry = trie.lookup(va);
    if (entry && update_lru)
        entry->lruSeq = nextSeq();
    return entry;
}

void
TLB::flushAll()
{
    DPRINTF(TLB, "Invalidating all entries.\n");
    for (unsigned i = 0; i < size; i++) {
        if (tlb[i].trieHandle) {
            trie.remove(tlb[i].trieHandle);
            tlb[i].trieHandle = NULL;
            freeList.push_back(&tlb[i]);
        }
    }

    for (int i = 0; i < L2_SETS; i++) {
        for (int j = 0; j < L2_WAYS; j++) {
            l2_sets[i].valid[j] = false;
            l2_sets[i].prefetched[j] = false;
        }
    }
}

void
TLB::setConfigAddress(uint32_t addr)
{
    configAddress = addr;
}

void
TLB::flushNonGlobal()
{
    DPRINTF(TLB, "Invalidating all non global entries.\n");
    for (unsigned i = 0; i < size; i++) {
        if (tlb[i].trieHandle && !tlb[i].global) {
            trie.remove(tlb[i].trieHandle);
            tlb[i].trieHandle = NULL;
            freeList.push_back(&tlb[i]);
        }
    }

    // FIX: the naivefp snapshot flushed only L1 on a non-global CR3 write
    // (x86 isa.cc calls this on every CR3 write when PCIDE/PGE allow it);
    // the L2 kept stale non-global translations, which l2_lookup would then
    // happily promote back into L1 for a process/ASID that no longer owns
    // that mapping. Clear non-global L2 entries too.
    for (int i = 0; i < L2_SETS; i++) {
        for (int j = 0; j < L2_WAYS; j++) {
            if (l2_sets[i].valid[j] && !l2_sets[i].entries[j].global) {
                if (l2_sets[i].prefetched[j])
                    stats.pfEvictedUnused++;
                l2_sets[i].valid[j] = false;
                l2_sets[i].prefetched[j] = false;
            }
        }
    }
}

void
TLB::demapPage(Addr va, uint64_t asn)
{
    // FIX: the naivefp snapshot did trie.lookup(va) with the RAW virtual
    // address, never applying concAddrPcid(). Every L1 key is stored as
    // (pageAlignedVaddr | pcid) (see translate() below), so for any
    // non-zero pcid this lookup always missed -- demapPage was a near
    // no-op for PCID-tagged processes, and it never touched the L2 at all,
    // so a stale L2 copy could be promoted straight back into L1 after an
    // OS-level unmap/remap (verified by the oracle: ORACLE-STALE-UNMAPPED
    // after a free()+mmap() reuse of the same VA with a different PCID).
    l2_remove(va);
    Addr pageAlignedVaddr = va & ~mask(X86ISA::PageShift);
    Addr concat_va = concAddrPcid(pageAlignedVaddr, asn);
    TlbEntry *entry = trie.lookup(concat_va);
    if (!entry && asn == 0) {
        // Backward-compatible fallback for callers that still pass a raw,
        // un-pcid'd address with asn==0.
        entry = trie.lookup(pageAlignedVaddr);
    }
    if (entry) {
        trie.remove(entry->trieHandle);
        entry->trieHandle = NULL;
        freeList.push_back(entry);
    }
}

namespace
{

Cycles
localMiscRegAccess(bool read, RegIndex regNum,
                   ThreadContext *tc, PacketPtr pkt)
{
    if (read) {
        RegVal data = htole(tc->readMiscReg(regNum));
        assert(pkt->getSize() <= sizeof(RegVal));
        pkt->setData((uint8_t *)&data);
    } else {
        RegVal data = htole(tc->readMiscRegNoEffect(regNum));
        assert(pkt->getSize() <= sizeof(RegVal));
        pkt->writeData((uint8_t *)&data);
        tc->setMiscReg(regNum, letoh(data));
    }
    return Cycles(1);
}

} // anonymous namespace

Fault
TLB::translateInt(bool read, RequestPtr req, ThreadContext *tc)
{
    DPRINTF(TLB, "Addresses references internal memory.\n");
    Addr vaddr = req->getVaddr();
    Addr prefix = (vaddr >> 3) & IntAddrPrefixMask;
    if (prefix == IntAddrPrefixCPUID) {
        panic("CPUID memory space not yet implemented!\n");
    } else if (prefix == IntAddrPrefixMSR) {
        vaddr = (vaddr >> 3) & ~IntAddrPrefixMask;

        RegIndex regNum;
        if (!msrAddrToIndex(regNum, vaddr))
            return std::make_shared<GeneralProtection>(0);

        req->setPaddr(req->getVaddr());
        req->setLocalAccessor(
            [read,regNum](ThreadContext *tc, PacketPtr pkt)
            {
                return localMiscRegAccess(read, regNum, tc, pkt);
            }
        );

        return NoFault;
    } else if (prefix == IntAddrPrefixIO) {
        // TODO If CPL > IOPL or in virtual mode, check the I/O permission
        // bitmap in the TSS.

        Addr IOPort = vaddr & ~IntAddrPrefixMask;
        // Make sure the address fits in the expected 16 bit IO address
        // space.
        assert(!(IOPort & ~0xFFFF));
        if (IOPort == 0xCF8 && req->getSize() == 4) {
            req->setPaddr(req->getVaddr());
            req->setLocalAccessor(
                [read](ThreadContext *tc, PacketPtr pkt)
                {
                    return localMiscRegAccess(
                            read, misc_reg::PciConfigAddress, tc, pkt);
                }
            );
        } else if ((IOPort & ~mask(2)) == 0xCFC) {
            req->setFlags(Request::UNCACHEABLE | Request::STRICT_ORDER);
            Addr configAddress =
                tc->readMiscRegNoEffect(misc_reg::PciConfigAddress);
            if (bits(configAddress, 31, 31)) {
                req->setPaddr(PhysAddrPrefixPciConfig |
                        mbits(configAddress, 30, 2) |
                        (IOPort & mask(2)));
            } else {
                req->setPaddr(PhysAddrPrefixIO | IOPort);
            }
        } else {
            req->setFlags(Request::UNCACHEABLE | Request::STRICT_ORDER);
            req->setPaddr(PhysAddrPrefixIO | IOPort);
        }
        return NoFault;
    } else {
        panic("Access to unrecognized internal address space %#x.\n",
                prefix);
    }
}

Fault
TLB::finalizePhysical(const RequestPtr &req,
                      ThreadContext *tc, BaseMMU::Mode mode) const
{
    Addr paddr = req->getPaddr();

    if (m5opRange.contains(paddr)) {
        req->setFlags(Request::STRICT_ORDER);
        uint8_t func;
        pseudo_inst::decodeAddrOffset(paddr - m5opRange.start(), func);
        req->setLocalAccessor(
            [func, mode](ThreadContext *tc, PacketPtr pkt) -> Cycles
            {
                uint64_t ret;
                pseudo_inst::pseudoInst<X86PseudoInstABI, true>(tc, func, ret);
                if (mode == BaseMMU::Read)
                    pkt->setLE(ret);
                return Cycles(1);
            }
        );
    } else if (FullSystem) {
        // Check for an access to the local APIC
        LocalApicBase localApicBase =
            tc->readMiscRegNoEffect(misc_reg::ApicBase);
        AddrRange apicRange(localApicBase.base * PageBytes,
                            (localApicBase.base + 1) * PageBytes);

        if (apicRange.contains(paddr)) {
            // The Intel developer's manuals say the below restrictions apply,
            // but the linux kernel, because of a compiler optimization, breaks
            // them.
            /*
            // Check alignment
            if (paddr & ((32/8) - 1))
                return new GeneralProtection(0);
            // Check access size
            if (req->getSize() != (32/8))
                return new GeneralProtection(0);
            */
            // Force the access to be uncacheable.
            req->setFlags(Request::UNCACHEABLE | Request::STRICT_ORDER);
            req->setPaddr(x86LocalAPICAddress(tc->contextId(),
                                              paddr - apicRange.start()));
        }
    }

    return NoFault;
}

Fault
TLB::translate(const RequestPtr &req,
        ThreadContext *tc, BaseMMU::Translation *translation,
        BaseMMU::Mode mode, bool &delayedResponse, bool timing)
{
    Request::Flags flags = req->getFlags();
    int seg = flags & SegmentFlagMask;
    bool storeCheck = flags & Request::READ_MODIFY_WRITE;

    delayedResponse = false;

    // If this is true, we're dealing with a request to a non-memory address
    // space.
    if (seg == segment_idx::Ms) {
        return translateInt(mode == BaseMMU::Read, req, tc);
    }

    Addr vaddr = req->getVaddr();
    DPRINTF(TLB, "Translating vaddr %#x.\n", vaddr);

    HandyM5Reg m5Reg = tc->readMiscRegNoEffect(misc_reg::M5Reg);

    const Addr logAddrSize = (flags >> AddrSizeFlagShift) & AddrSizeFlagMask;
    const int addrSize = 8 << logAddrSize;
    const Addr addrMask = mask(addrSize);

    // If protected mode has been enabled...
    if (m5Reg.prot) {
        DPRINTF(TLB, "In protected mode.\n");
        // If we're not in 64-bit mode, do protection/limit checks
        if (m5Reg.mode != LongMode) {
            DPRINTF(TLB, "Not in long mode. Checking segment protection.\n");

            // CPUs won't know to use CS when building fetch requests, so we
            // need to override the value of "seg" here if this is a fetch.
            if (mode == BaseMMU::Execute)
                seg = segment_idx::Cs;

            SegAttr attr = tc->readMiscRegNoEffect(misc_reg::segAttr(seg));
            // Check for an unusable segment.
            if (attr.unusable) {
                DPRINTF(TLB, "Unusable segment.\n");
                return std::make_shared<GeneralProtection>(0);
            }
            bool expandDown = false;
            if (seg >= segment_idx::Es && seg <= segment_idx::Hs) {
                if (!attr.writable && (mode == BaseMMU::Write || storeCheck)) {
                    DPRINTF(TLB, "Tried to write to unwritable segment.\n");
                    return std::make_shared<GeneralProtection>(0);
                }
                if (!attr.readable && mode == BaseMMU::Read) {
                    DPRINTF(TLB, "Tried to read from unreadble segment.\n");
                    return std::make_shared<GeneralProtection>(0);
                }
                expandDown = attr.expandDown;

            }
            Addr base = tc->readMiscRegNoEffect(misc_reg::segBase(seg));
            Addr limit = tc->readMiscRegNoEffect(misc_reg::segLimit(seg));
            Addr offset;
            if (mode == BaseMMU::Execute)
                offset = vaddr - base;
            else
                offset = (vaddr - base) & addrMask;
            Addr endOffset = offset + req->getSize() - 1;
            if (expandDown) {
                DPRINTF(TLB, "Checking an expand down segment.\n");
                warn_once("Expand down segments are untested.\n");
                if (offset <= limit || endOffset <= limit)
                    return std::make_shared<GeneralProtection>(0);
            } else {
                if (offset > limit || endOffset > limit) {
                    DPRINTF(TLB, "Segment limit check failed, "
                            "offset = %#x limit = %#x.\n", offset, limit);
                    return std::make_shared<GeneralProtection>(0);
                }
            }
        }
        if (m5Reg.submode != SixtyFourBitMode && addrSize != 64)
            vaddr &= mask(32);
        // If paging is enabled, do the translation.
        if (m5Reg.paging) {
            DPRINTF(TLB, "Paging enabled.\n");
            // The vaddr already has the segment base applied.

            //Appending the pcid (last 12 bits of CR3) to the
            //page aligned vaddr if pcide is set
            CR4 cr4 = tc->readMiscRegNoEffect(misc_reg::Cr4);
            Addr pageAlignedVaddr = vaddr & (~mask(X86ISA::PageShift));
            CR3 cr3 = tc->readMiscRegNoEffect(misc_reg::Cr3);
            uint64_t pcid;

            if (cr4.pcide)
                pcid = cr3.pcid;
            else
                pcid = 0x000;

            pageAlignedVaddr = concAddrPcid(pageAlignedVaddr, pcid);
            TlbEntry *entry = lookup(pageAlignedVaddr);

            if (!entry) {
                // It missed in L1. Check the L2.
                TlbEntry *l2_entry = l2_lookup(pageAlignedVaddr);

                if (l2_entry) {
                    DPRINTF(TLB, "SUCCESS: L2 TLB HIT for address %#x!\n", pageAlignedVaddr);
                    // Was this hit a prefetched line paying off? Count it
                    // before the copy into L1 clears the slot's identity.
                    {
                        Addr true_vpn = pageAlignedVaddr >> X86ISA::PageShift;
                        uint32_t set_idx = xor_7_hash(true_vpn);
                        for (int i = 0; i < L2_WAYS; i++) {
                            if (l2_sets[set_idx].valid[i] &&
                                &l2_sets[set_idx].entries[i] == l2_entry &&
                                l2_sets[set_idx].prefetched[i]) {
                                stats.pfUseful++;
                                pf_epoch_hits++;
                                pf_window_hits++;
                                l2_sets[set_idx].prefetched[i] = false;
                                if (pfCfg().adaptive == PfAdaptive::EXP)
                                    pf_degree_cur = PfConfig::clampDegree(pf_degree_cur * 2);
                                else if (pfCfg().adaptive == PfAdaptive::ADD)
                                    pf_degree_cur = PfConfig::clampDegree(pf_degree_cur + 1);
                                else if (pfCfg().adaptive == PfAdaptive::AIMD)
                                    pf_degree_cur = PfConfig::clampDegree(pf_degree_cur + 1);
                            }
                        }
                    }
                    // Copy it into the L1.
                    entry = insert(pageAlignedVaddr, *l2_entry, pcid);
                } else {
                    DPRINTF(TLB, "L2 TLB MISS for address %#x. Going to Walker...\n", pageAlignedVaddr);
                }
            }

            switch (mode) {
                case BaseMMU::Read:
                    stats.rdAccesses++;
                    break;
                case BaseMMU::Write:
                    stats.wrAccesses++;
                    break;
                case BaseMMU::Execute:
                    stats.exAccesses++;
                    break;
                default:
                    panic("Invalid mode\n");
                    break;
            }
            if (!entry) {
                DPRINTF(TLB, "Handling a TLB miss for "
                        "address %#x at pc %#x.\n",
                        vaddr, tc->pcState().instAddr());
                switch (mode) {
                    case BaseMMU::Read:
                        stats.rdMisses++;
                        break;
                    case BaseMMU::Write:
                        stats.wrMisses++;
                        break;
                    case BaseMMU::Execute:
                        stats.exMisses++;
                        break;
                    default:
                        panic("Invalid mode\n");
                        break;
                }
                if (FullSystem) {
                    Fault fault = walker->start(tc, translation, req, mode);
                    if (timing || fault != NoFault) {
                        // This gets ignored in atomic mode.
                        delayedResponse = true;
                        return fault;
                    }
                    entry = lookup(pageAlignedVaddr);
                    assert(entry);
                } else {
                    Process *p = tc->getProcessPtr();
                    const EmulationPageTable::Entry *pte =
                        p->pTable->lookup(vaddr);
                    if (!pte) {
                        return std::make_shared<PageFault>(vaddr, true, mode,
                                                           true, false);
                    } else {
                        Addr alignedVaddr = p->pTable->pageAlign(vaddr);
                        DPRINTF(TLB, "Mapping %#x to %#x\n", alignedVaddr,
                                pte->paddr);
                        entry = insert(alignedVaddr, TlbEntry(
                                p->pTable->pid(), alignedVaddr, pte->paddr,
                                pte->flags & EmulationPageTable::Uncacheable,
                                pte->flags & EmulationPageTable::ReadOnly),
                                pcid);

                        // --- Full miss: a new prefetch window starts here.
                        // A window-boundary miss is EXPECTED once per window
                        // even for a perfectly-predicted stream (a window-
                        // based prefetcher cannot avoid that one walk) so it
                        // must not by itself count as a misprediction. Only
                        // treat it as "reset on mismatch" when the PRIOR
                        // window produced zero useful hits at all -- i.e. the
                        // prefetcher is not tracking this access stream.
                        // pf_window_hits counts useful hits since the last
                        // full miss; checked before being reset for the new
                        // window about to start. ---
                        PfConfig &cfg = pfCfg();
                        if (pf_have_prev_miss) {
                            int64_t stride =
                                (int64_t)(alignedVaddr - pf_prev_miss_vaddr) /
                                (int64_t)X86ISA::PageBytes;
                            if (stride != 0)
                                pf_stride_pages = stride;
                        }
                        pf_prev_miss_vaddr = alignedVaddr;
                        pf_have_prev_miss = true;

                        if (pf_window_hits == 0) {
                            if (cfg.adaptive == PfAdaptive::EXP ||
                                cfg.adaptive == PfAdaptive::ADD) {
                                pf_degree_cur = 1;
                            } else if (cfg.adaptive == PfAdaptive::AIMD) {
                                pf_degree_cur = std::max((uint32_t)1, pf_degree_cur / 2);
                            }
                        }
                        pf_window_hits = 0;

                        // --- Accuracy-throttled degree: once per epoch,
                        // check hit rate and halve degree if under 50%. ---
                        pf_epoch_issued++;
                        if (cfg.throttle && pf_epoch_issued >= PF_EPOCH_LEN) {
                            pf_throttled = (pf_epoch_hits * 2 < pf_epoch_issued);
                            pf_epoch_issued = 0;
                            pf_epoch_hits = 0;
                        }

                        uint32_t degree = (cfg.adaptive != PfAdaptive::OFF)
                                               ? pf_degree_cur : cfg.baseDegree;
                        if (cfg.throttle && pf_throttled)
                            degree = std::max((uint32_t)1, degree / 2);

                        // NAIVE-FREE-PREFETCHER, generalised: for 'degree'
                        // 8-page windows (8..64 pages), pick the candidate
                        // neighbor pages per AGILE_PF_WINDOW/_DIR, install
                        // any that are present per AGILE_PF_TARGET/_PRIORITY.
                        uint32_t windowPages = degree * 8;
                        Addr windowBase;
                        if (cfg.window == PfWindow::ALIGNED) {
                            Addr windowBytes = (Addr)windowPages * X86ISA::PageBytes;
                            windowBase = alignedVaddr & ~(windowBytes - 1);
                        } else {
                            windowBase = alignedVaddr; // unaligned: starts at the demand page
                        }

                        for (uint32_t i = 0; i < windowPages; i++) {
                            Addr pref_vaddr;
                            if (cfg.dir == PfDir::DESC) {
                                pref_vaddr = alignedVaddr -
                                    (Addr)(i + 1) * X86ISA::PageBytes;
                            } else if (cfg.dir == PfDir::STRIDE) {
                                int64_t s = pf_stride_pages == 0 ? 1 : pf_stride_pages;
                                pref_vaddr = alignedVaddr +
                                    (Addr)((int64_t)(i + 1) * s) * X86ISA::PageBytes;
                            } else if (cfg.window == PfWindow::ALIGNED) {
                                pref_vaddr = windowBase + (Addr)i * X86ISA::PageBytes;
                            } else {
                                pref_vaddr = alignedVaddr + (Addr)(i + 1) * X86ISA::PageBytes;
                            }
                            if (pref_vaddr == alignedVaddr)
                                continue; // skip the demand miss itself

                            stats.pfIssued++;
                            const EmulationPageTable::Entry *pref_pte =
                                p->pTable->lookup(pref_vaddr);
                            if (!pref_pte) {
                                // Nothing legal to install for an unmapped
                                // neighbor in SE mode either way; AGILE_PF_SKIP_NP
                                // documents the policy, there is no unsafe
                                // alternative to fall back to.
                                continue;
                            }

                            TlbEntry pfEntry(p->pTable->pid(), pref_vaddr,
                                pref_pte->paddr,
                                pref_pte->flags & EmulationPageTable::Uncacheable,
                                pref_pte->flags & EmulationPageTable::ReadOnly);

                            bool lowPrio = (cfg.priority == PfPriority::LOW);
                            if (cfg.target == PfTarget::L1) {
                                insert(pref_vaddr, pfEntry, pcid);
                                stats.pfInstalled++;
                            } else if (cfg.target == PfTarget::SPLIT) {
                                // First 2 neighbours (in scan order) go to
                                // L1, the rest to L2.
                                if (i < 2) {
                                    insert(pref_vaddr, pfEntry, pcid);
                                } else {
                                    l2_insert(pref_vaddr, pfEntry, pcid,
                                              /*is_prefetch=*/true, lowPrio);
                                }
                                stats.pfInstalled++;
                            } else { // L2 (default)
                                l2_insert(pref_vaddr, pfEntry, pcid,
                                          /*is_prefetch=*/true, lowPrio);
                                stats.pfInstalled++;
                            }
                            DPRINTF(TLB, "AGILE PREFETCHER: Prefetched %#x "
                                    "(degree=%u target=%d dir=%d)\n",
                                    pref_vaddr, degree, (int)cfg.target,
                                    (int)cfg.dir);
                        }
                    }
                    DPRINTF(TLB, "Miss was serviced.\n");
                }
            }

            DPRINTF(TLB, "Entry found with paddr %#x, "
                    "doing protection checks.\n", entry->paddr);
            // Do paging protection checks.
            bool inUser = m5Reg.cpl == 3 && !(flags & CPL0FlagBit);
            CR0 cr0 = tc->readMiscRegNoEffect(misc_reg::Cr0);
            bool badWrite = (!entry->writable && (inUser || cr0.wp));
            if ((inUser && !entry->user) ||
                (mode == BaseMMU::Write && badWrite)) {
                // The page must have been present to get into the TLB in
                // the first place. We'll assume the reserved bits are
                // fine even though we're not checking them.
                return std::make_shared<PageFault>(vaddr, true, mode, inUser,
                                                   false);
            }
            if (storeCheck && badWrite) {
                // This would fault if this were a write, so return a page
                // fault that reflects that happening.
                return std::make_shared<PageFault>(
                    vaddr, true, BaseMMU::Write, inUser, false);
            }

            Addr paddr = entry->paddr | (vaddr & mask(entry->logBytes));
            DPRINTF(TLB, "Translated %#x -> %#x.\n", vaddr, paddr);
            req->setPaddr(paddr);
            if (entry->uncacheable)
                req->setFlags(Request::UNCACHEABLE | Request::STRICT_ORDER);
        } else {
            //Use the address which already has segmentation applied.
            DPRINTF(TLB, "Paging disabled.\n");
            DPRINTF(TLB, "Translated %#x -> %#x.\n", vaddr, vaddr);
            req->setPaddr(vaddr);
        }
    } else {
        // Real mode
        DPRINTF(TLB, "In real mode.\n");
        DPRINTF(TLB, "Translated %#x -> %#x.\n", vaddr, vaddr);
        req->setPaddr(vaddr);
    }

    return finalizePhysical(req, tc, mode);
}

Fault
TLB::translateAtomic(const RequestPtr &req, ThreadContext *tc,
    BaseMMU::Mode mode)
{
    bool delayedResponse;
    // CLFLUSHOPT/WB/FLUSH should be treated as read for protection checks
    if (req->isCacheClean())
        mode = BaseMMU::Read;
    return TLB::translate(req, tc, NULL, mode, delayedResponse, false);
}

Fault
TLB::translateFunctional(const RequestPtr &req, ThreadContext *tc,
    BaseMMU::Mode mode)
{
    // CLFLUSHOPT/WB/FLUSH should be treated as read for protection checks
    if (req->isCacheClean())
        mode = BaseMMU::Read;
    unsigned logBytes;
    const Addr vaddr = req->getVaddr();
    Addr addr = vaddr;
    Addr paddr = 0;
    if (FullSystem) {
        Fault fault = walker->startFunctional(tc, addr, logBytes, mode);
        if (fault != NoFault)
            return fault;
        paddr = insertBits(addr, logBytes - 1, 0, vaddr);
    } else {
        Process *process = tc->getProcessPtr();
        const auto *pte = process->pTable->lookup(vaddr);

        if (!pte && mode != BaseMMU::Execute) {
            // Check if we just need to grow the stack.
            if (process->fixupFault(vaddr)) {
                // If we did, lookup the entry for the new page.
                pte = process->pTable->lookup(vaddr);
            }
        }

        if (!pte)
            return std::make_shared<PageFault>(vaddr, true, mode, true, false);

        paddr = pte->paddr | process->pTable->pageOffset(vaddr);
    }
    DPRINTF(TLB, "Translated (functional) %#x -> %#x.\n", vaddr, paddr);
    req->setPaddr(paddr);
    return NoFault;
}

void
TLB::translateTiming(const RequestPtr &req, ThreadContext *tc,
    BaseMMU::Translation *translation, BaseMMU::Mode mode)
{
    bool delayedResponse;
    assert(translation);
    // CLFLUSHOPT/WB/FLUSH should be treated as read for protection checks
    BaseMMU::Mode orig_mode = mode;
    if (req->isCacheClean())
        mode = BaseMMU::Read;
    Fault fault =
        TLB::translate(req, tc, translation, mode, delayedResponse, true);
    if (!delayedResponse)
        translation->finish(fault, req, tc, orig_mode);
    else
        translation->markDelayed();
}

Walker *
TLB::getWalker()
{
    return walker;
}

TLB::TlbStats::TlbStats(statistics::Group *parent)
    : statistics::Group(parent),
      ADD_STAT(rdAccesses, statistics::units::Count::get(),
               "TLB accesses on read requests"),
      ADD_STAT(wrAccesses, statistics::units::Count::get(),
               "TLB accesses on write requests"),
      ADD_STAT(exAccesses, statistics::units::Count::get(),
               "TLB accesses on execute (instr) requests"),
      ADD_STAT(rdMisses, statistics::units::Count::get(),
               "TLB misses on read requests"),
      ADD_STAT(wrMisses, statistics::units::Count::get(),
               "TLB misses on write requests"),
      ADD_STAT(exMisses, statistics::units::Count::get(),
               "TLB misses on execute (instr) requests"),
      ADD_STAT(pfIssued, statistics::units::Count::get(),
               "AGILE prefetcher: neighbor lookups attempted"),
      ADD_STAT(pfInstalled, statistics::units::Count::get(),
               "AGILE prefetcher: entries installed (present neighbors)"),
      ADD_STAT(pfUseful, statistics::units::Count::get(),
               "AGILE prefetcher: demand hits that landed on a prefetched entry"),
      ADD_STAT(pfUnused, statistics::units::Count::get(),
               "AGILE prefetcher: prefetched entries evicted without ever being demanded"),
      ADD_STAT(pfEvictedUnused, statistics::units::Count::get(),
               "AGILE prefetcher: pollution -- same as pfUnused, counted at the eviction site")
{
}

void
TLB::serialize(CheckpointOut &cp) const
{
    // Only store the entries in use.
    uint32_t _size = size - freeList.size();
    SERIALIZE_SCALAR(_size);
    SERIALIZE_SCALAR(lruSeq);

    uint32_t _count = 0;
    for (uint32_t x = 0; x < size; x++) {
        if (tlb[x].trieHandle != NULL)
            tlb[x].serializeSection(cp, csprintf("Entry%d", _count++));
    }

    // FIX: the naivefp snapshot never serialized the L2 array at all. After
    // a checkpoint restore the L2 silently came back empty: not a
    // correctness bug by itself (restored state is a subset of valid
    // states), but it breaks reproducibility -- a checkpoint taken mid-run
    // and resumed would show cold-L2 performance instead of matching an
    // uninterrupted run, and more importantly this *looked* like a
    // correctness bug during verification until we checked here.
    SERIALIZE_SCALAR(l2_lruSeq);
    uint32_t _l2count = 0;
    for (uint32_t s = 0; s < L2_SETS; s++) {
        for (uint32_t w = 0; w < L2_WAYS; w++) {
            if (l2_sets[s].valid[w]) {
                l2_sets[s].entries[w].serializeSection(
                    cp, csprintf("L2Entry%d", _l2count));
                bool pf = l2_sets[s].prefetched[w];
                paramOut(cp, csprintf("L2Entry%d_prefetched", _l2count), pf);
                _l2count++;
            }
        }
    }
    SERIALIZE_SCALAR(_l2count);
}

void
TLB::unserialize(CheckpointIn &cp)
{
    // Do not allow to restore with a smaller tlb.
    uint32_t _size;
    UNSERIALIZE_SCALAR(_size);
    if (_size > size) {
        fatal("TLB size less than the one in checkpoint!");
    }

    UNSERIALIZE_SCALAR(lruSeq);

    for (uint32_t x = 0; x < _size; x++) {
        TlbEntry *newEntry = freeList.front();
        freeList.pop_front();

        newEntry->unserializeSection(cp, csprintf("Entry%d", x));
        newEntry->trieHandle = trie.insert(newEntry->vaddr,
            TlbEntryTrie::MaxBits - newEntry->logBytes, newEntry);
    }

    // FIX: restore the L2 state saved above (absent entirely in naivefp).
    for (uint32_t i = 0; i < L2_SETS; i++) {
        for (uint32_t j = 0; j < L2_WAYS; j++) {
            l2_sets[i].valid[j] = false;
            l2_sets[i].prefetched[j] = false;
        }
    }
    UNSERIALIZE_SCALAR(l2_lruSeq);
    uint32_t _l2count = 0;
    UNSERIALIZE_SCALAR(_l2count);
    for (uint32_t c = 0; c < _l2count; c++) {
        TlbEntry tmp;
        tmp.unserializeSection(cp, csprintf("L2Entry%d", c));
        bool pf = false;
        paramIn(cp, csprintf("L2Entry%d_prefetched", c), pf);
        Addr true_vpn = tmp.vaddr >> X86ISA::PageShift;
        uint32_t set_idx = xor_7_hash(true_vpn);
        for (uint32_t w = 0; w < L2_WAYS; w++) {
            if (!l2_sets[set_idx].valid[w]) {
                l2_sets[set_idx].valid[w] = true;
                l2_sets[set_idx].entries[w] = tmp;
                l2_sets[set_idx].prefetched[w] = pf;
                break;
            }
        }
    }
}

Port *
TLB::getTableWalkerPort()
{
    return &walker->getPort("port");
}

} // namespace X86ISA
} // namespace gem5
