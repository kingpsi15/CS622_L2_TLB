// =====================================================================
// Inclusive L2 TLB (fixed). Environment variables read once at TLB
// construction to select the architecture variant at runtime (one binary
// covers every combination; recompile only needed when this file changes):
//
//   TLB_L2_GEOM = 64x8 | 128x4 (default) | 256x2 | fa
//                 L2 geometry: sets x ways. "fa" = fully associative
//                 (1 set x 512 ways). Total L2 capacity is always 512
//                 entries so associativity is comparable across geometries.
//   TLB_L2_HASH = mod | xor7 (default) | xorfold
//                 Set-index hash applied to the VPN. "mod" = vpn % sets;
//                 "xor7" = low-bits XOR next-bits (generalizes the
//                 original 7-bit XOR fold to any power-of-2 set count);
//                 "xorfold" = XOR of every index-width chunk of the VPN.
//   TLB_L2_REPL = lru (default) | fifo | random | plru
//                 Per-set replacement policy.
//   TLB_L1_SIZE = <integer>
//                 Overrides the SimObject L1 size (p.size) with a runtime
//                 value, e.g. 32/64/128, without touching the .py config.
//
// Unrecognized values fatal() at construction with the bad value named.
// =====================================================================

#include "arch/x86/tlb.hh"

#include <cstring>
#include <memory>

#include "arch/x86/faults.hh"
#include "arch/x86/insts/microldstop.hh"
#include "arch/x86/pagetable_walker.hh"
#include "arch/x86/pseudo_inst_abi.hh"
#include "arch/x86/regs/misc.hh"
#include "arch/x86/regs/msr.hh"
#include "arch/x86/x86_traits.hh"
#include "base/trace.hh"
#include "cpu/thread_context.hh"
#include "debug/TLB.hh"
#include "mem/packet_access.hh"
#include "mem/page_table.hh"
#include "mem/request.hh"
#include "sim/full_system.hh"
#include "sim/process.hh"
#include "sim/pseudo_inst.hh"

namespace gem5
{

namespace
{

uint32_t
log2u(uint32_t x)
{
    uint32_t n = 0;
    while ((1u << n) < x)
        n++;
    return n;
}

uint32_t
pickL1Size(uint32_t fallback)
{
    if (const char *s = std::getenv("TLB_L1_SIZE")) {
        char *end = nullptr;
        long v = strtol(s, &end, 0);
        if (!end || *end != '\0' || v <= 0)
            fatal("TLB_L1_SIZE=%s is not a positive integer\n", s);
        return (uint32_t)v;
    }
    return fallback;
}

void
pickL2Config(uint32_t &sets, uint32_t &ways,
             X86ISA::L2HashKind &hash, X86ISA::L2ReplKind &repl)
{
    const char *geom = std::getenv("TLB_L2_GEOM");
    if (!geom || !strcmp(geom, "128x4")) {
        sets = 128; ways = 4;
    } else if (!strcmp(geom, "64x8")) {
        sets = 64; ways = 8;
    } else if (!strcmp(geom, "256x2")) {
        sets = 256; ways = 2;
    } else if (!strcmp(geom, "fa")) {
        sets = 1; ways = 512;
    } else {
        fatal("TLB_L2_GEOM=%s not one of 64x8|128x4|256x2|fa\n", geom);
    }

    const char *hs = std::getenv("TLB_L2_HASH");
    if (!hs || !strcmp(hs, "xor7"))
        hash = X86ISA::L2HashKind::Xor7;
    else if (!strcmp(hs, "mod"))
        hash = X86ISA::L2HashKind::Mod;
    else if (!strcmp(hs, "xorfold"))
        hash = X86ISA::L2HashKind::XorFold;
    else
        fatal("TLB_L2_HASH=%s not one of mod|xor7|xorfold\n", hs);

    const char *rp = std::getenv("TLB_L2_REPL");
    if (!rp || !strcmp(rp, "lru"))
        repl = X86ISA::L2ReplKind::Lru;
    else if (!strcmp(rp, "fifo"))
        repl = X86ISA::L2ReplKind::Fifo;
    else if (!strcmp(rp, "random"))
        repl = X86ISA::L2ReplKind::Random;
    else if (!strcmp(rp, "plru"))
        repl = X86ISA::L2ReplKind::Plru;
    else
        fatal("TLB_L2_REPL=%s not one of lru|fifo|random|plru\n", rp);
}

} // anonymous namespace

namespace X86ISA {

TLB::TLB(const Params &p)
    : BaseTLB(p), configAddress(0), size(pickL1Size(p.size)),
      tlb(size), lruSeq(0),
      l2_lruSeq(0), // <--- MODIFIED FOR SET-ASSOCIATIVE
      m5opRange(p.system->m5opRange()), stats(this)
{
    if (!size)
        fatal("TLBs must have a non-zero size.\n");

    for (int x = 0; x < size; x++) {
        tlb[x].trieHandle = NULL;
        freeList.push_back(&tlb[x]);
    }

    // --- RUNTIME-SELECTABLE L2 SET-ASSOCIATIVE SETUP ---
    pickL2Config(l2Sets, l2Ways, l2HashKind, l2ReplKind);
    l2SetBits = log2u(l2Sets);
    l2Rng = 0x9E3779B97F4A7C15ULL ^ (uint64_t)(uintptr_t)this;
    uint32_t l2Total = l2Sets * l2Ways;
    l2Entry.resize(l2Total);
    l2Valid.assign(l2Total, 0);
    l2Order.assign(l2Total, 0);
    if (l2Ways > 1)
        l2Plru.assign((size_t)l2Sets * (l2Ways - 1), 0);
    // ----------------------------------------------

    walker = p.walker;
    walker->setTLB(this);
}

// --- SET-ASSOCIATIVE L2 HELPER FUNCTIONS ---

uint32_t
TLB::l2SetIndex(Addr vpn) const
{
    if (l2Sets == 1)
        return 0;
    Addr idxMask = l2Sets - 1;
    switch (l2HashKind) {
      case L2HashKind::Mod:
        return (uint32_t)(vpn % l2Sets);
      case L2HashKind::Xor7: {
        uint32_t lo = (uint32_t)(vpn & idxMask);
        uint32_t hi = (uint32_t)((vpn >> l2SetBits) & idxMask);
        return lo ^ hi;
      }
      case L2HashKind::XorFold: {
        uint32_t h = 0;
        Addr v = vpn;
        while (v) {
            h ^= (uint32_t)(v & idxMask);
            v >>= l2SetBits;
        }
        return h;
      }
    }
    return 0;
}

uint64_t
TLB::l2Rand()
{
    // xorshift64*; local to this TLB instance so we never touch libc's
    // global rand()/srand() state shared with the rest of the simulator.
    l2Rng ^= l2Rng >> 12;
    l2Rng ^= l2Rng << 25;
    l2Rng ^= l2Rng >> 27;
    return l2Rng * 0x2545F4914F6CDD1DULL;
}

uint32_t
TLB::l2PlruVictim(uint32_t set) const
{
    uint32_t levels = log2u(l2Ways);
    uint32_t base = set * (l2Ways - 1);
    uint32_t node = 0, pos = 0;
    for (uint32_t lvl = 0; lvl < levels; lvl++) {
        bool bit = l2Plru[base + node] != 0;
        pos = (pos << 1) | (bit ? 1u : 0u);
        node = 2 * node + 1 + (bit ? 1u : 0u);
    }
    return pos;
}

void
TLB::l2TouchPlru(uint32_t set, uint32_t way)
{
    uint32_t levels = log2u(l2Ways);
    uint32_t base = set * (l2Ways - 1);
    uint32_t node = 0;
    for (uint32_t lvl = 0; lvl < levels; lvl++) {
        uint32_t bit = (way >> (levels - 1 - lvl)) & 1u;
        // Point the node away from the branch we just used, so the next
        // victim search walks toward the opposite (least-recently-used)
        // subtree.
        l2Plru[base + node] = bit ? 0 : 1;
        node = 2 * node + 1 + bit;
    }
}

uint32_t
TLB::l2PickVictim(uint32_t set)
{
    uint32_t base = set * l2Ways;
    for (uint32_t w = 0; w < l2Ways; w++)
        if (!l2Valid[base + w])
            return w;

    switch (l2ReplKind) {
      case L2ReplKind::Random:
        return (uint32_t)(l2Rand() % l2Ways);
      case L2ReplKind::Plru:
        return l2PlruVictim(set);
      case L2ReplKind::Fifo:
      case L2ReplKind::Lru:
      default: {
        uint32_t victim = 0;
        for (uint32_t w = 1; w < l2Ways; w++)
            if (l2Order[base + w] < l2Order[base + victim])
                victim = w;
        return victim;
      }
    }
}

TlbEntry *TLB::l2_lookup(Addr va, bool update_lru) {
    Addr true_vpn = va >> X86ISA::PageShift;
    uint32_t set_idx = l2SetIndex(true_vpn);
    uint32_t base = set_idx * l2Ways;

    for (uint32_t i = 0; i < l2Ways; i++) {
        if (l2Valid[base + i] && l2Entry[base + i].vaddr == va) {
            if (update_lru) {
                if (l2ReplKind == L2ReplKind::Lru)
                    l2Order[base + i] = ++l2_lruSeq;
                else if (l2ReplKind == L2ReplKind::Plru)
                    l2TouchPlru(set_idx, i);
                // FIFO/random: order is not touched on a hit.
            }
            return &l2Entry[base + i];
        }
    }
    return NULL;
}

// FIX (address-space bug, TLB_IMPLEMENTATION_AUDIT.md Approach 3 #4): the
// original l2_remove(Addr va) masked off the low 12 bits of both the
// lookup key and the stored key before comparing, which also strips the
// PCID that concAddrPcid() packs into those same low bits. Two different
// processes mapping the same virtual page therefore matched the same
// comparison, so demapPage() in one process could silently invalidate the
// other process's unrelated L2 entry (or leave its own stale, if the other
// process's entry happened to occupy the matching way first). Fixing this
// requires knowing the caller's ASID, so the signature gained an asn
// parameter (see demapPage below) and the match is now an exact key
// comparison, consistent with l2_insert/l2_lookup.
void TLB::l2_remove(Addr va, uint64_t asn) {
    Addr pageAligned = va & ~mask(X86ISA::PageShift);
    Addr key = concAddrPcid(pageAligned, asn);
    Addr true_vpn = key >> X86ISA::PageShift;
    uint32_t set_idx = l2SetIndex(true_vpn);
    uint32_t base = set_idx * l2Ways;

    for (uint32_t i = 0; i < l2Ways; i++) {
        if (l2Valid[base + i] && l2Entry[base + i].vaddr == key) {
            l2Valid[base + i] = false;
        }
    }
}

TlbEntry *TLB::l2_insert(Addr vpn, const TlbEntry &entry, uint64_t pcid) {
    Addr concat_va = concAddrPcid(vpn, pcid);
    Addr true_vpn = concat_va >> X86ISA::PageShift;
    uint32_t set_idx = l2SetIndex(true_vpn);
    uint32_t base = set_idx * l2Ways;

    // Check if it's already there
    for (uint32_t i = 0; i < l2Ways; i++) {
        if (l2Valid[base + i] && l2Entry[base + i].vaddr == concat_va) {
            return &l2Entry[base + i];
        }
    }

    uint32_t way = l2PickVictim(set_idx);
    bool wasValid = l2Valid[base + way];

    // INCLUSIVE POLICY ADDITION:
    // If the L2 set is full, we must evict the chosen way.
    // Since we are evicting this from L2, it MUST be evicted from L1 as well!
    if (wasValid) {
        Addr vaddr_to_evict = l2Entry[base + way].vaddr;
        TlbEntry* l1_entry = trie.lookup(vaddr_to_evict);
        if (l1_entry) {
            trie.remove(l1_entry->trieHandle);
            l1_entry->trieHandle = NULL;
            freeList.push_back(l1_entry);
            DPRINTF(TLB, "INCLUSIVE POLICY: Evicting %#x from L1 because it was evicted from L2!\n", vaddr_to_evict);
        }
    }

    // Overwrite the victim in the L2 set
    l2Valid[base + way] = true;
    l2Entry[base + way] = entry;
    l2Entry[base + way].vaddr = concat_va;
    l2Order[base + way] = ++l2_lruSeq;
    if (l2ReplKind == L2ReplKind::Plru)
        l2TouchPlru(set_idx, way);

    return &l2Entry[base + way];
}
// -------------------------------------------

void
TLB::evictLRU()
{
    // Find the entry with the lowest (and hence least recently updated)
    // sequence number.

    unsigned lru = 0;
    for (unsigned i = 1; i < size; i++) {
        if (tlb[i].lruSeq < tlb[lru].lruSeq)
            lru = i;
    }

    assert(tlb[lru].trieHandle);
    trie.remove(tlb[lru].trieHandle);
    tlb[lru].trieHandle = NULL;
    freeList.push_back(&tlb[lru]);
}

TlbEntry *
TLB::insert(Addr vpn, const TlbEntry &entry, uint64_t pcid)
{
    // --- ADD THIS LINE ---
    l2_insert(vpn, entry, pcid); // Put a copy in the L2!
    // ---------------------

    //Adding pcid to the page address so
    //that multiple processes using the same
    //tlb do not conflict when using the same
    //virtual addresses
    vpn = concAddrPcid(vpn, pcid);

    // If somebody beat us to it, just use that existing entry.
    TlbEntry *newEntry = trie.lookup(vpn);
    if (newEntry) {
        assert(newEntry->vaddr == vpn);
        return newEntry;
    }

    if (freeList.empty())
        evictLRU();

    newEntry = freeList.front();
    freeList.pop_front();

    *newEntry = entry;
    newEntry->lruSeq = nextSeq();
    newEntry->vaddr = vpn;
    if (FullSystem) {
        newEntry->trieHandle =
        trie.insert(vpn, TlbEntryTrie::MaxBits-entry.logBytes, newEntry);
    }
    else {
        newEntry->trieHandle =
        trie.insert(vpn, TlbEntryTrie::MaxBits, newEntry);
    }
    return newEntry;
}

TlbEntry *
TLB::lookup(Addr va, bool update_lru)
{
    TlbEntry *entry = trie.lookup(va);
    if (entry && update_lru)
        entry->lruSeq = nextSeq();
    return entry;
}

void
TLB::flushAll()
{
    DPRINTF(TLB, "Invalidating all entries.\n");
    for (unsigned i = 0; i < size; i++) {
        if (tlb[i].trieHandle) {
            trie.remove(tlb[i].trieHandle);
            tlb[i].trieHandle = NULL;
            freeList.push_back(&tlb[i]);
        }
    }

    // --- ADD THIS TO FLUSH L2 ---
    std::fill(l2Valid.begin(), l2Valid.end(), 0);
    // ----------------------------
}

void
TLB::setConfigAddress(uint32_t addr)
{
    configAddress = addr;
}

void
TLB::flushNonGlobal()
{
    DPRINTF(TLB, "Invalidating all non global entries.\n");
    for (unsigned i = 0; i < size; i++) {
        if (tlb[i].trieHandle && !tlb[i].global) {
            trie.remove(tlb[i].trieHandle);
            tlb[i].trieHandle = NULL;
            freeList.push_back(&tlb[i]);
        }
    }
    uint32_t l2Total = l2Sets * l2Ways;
    for (uint32_t i = 0; i < l2Total; i++) {
        if (l2Valid[i] && !l2Entry[i].global)
            l2Valid[i] = false;
    }
}

void
TLB::demapPage(Addr va, uint64_t asn)
{
    // FIX: pass the ASID through so l2_remove() can scope the removal to
    // this address space instead of matching any process's identical VPN
    // (see l2_remove's comment above for the bug this closes).
    l2_remove(va, asn);
    Addr pageAlignedVaddr = va & ~mask(X86ISA::PageShift);
    Addr concat_va = concAddrPcid(pageAlignedVaddr, asn);
    TlbEntry *entry = trie.lookup(concat_va);
    if (!entry && asn == 0) {
        entry = trie.lookup(pageAlignedVaddr);
    }
    if (entry) {
        trie.remove(entry->trieHandle);
        entry->trieHandle = NULL;
        freeList.push_back(entry);
    }
}

namespace
{

Cycles
localMiscRegAccess(bool read, RegIndex regNum,
                   ThreadContext *tc, PacketPtr pkt)
{
    if (read) {
        RegVal data = htole(tc->readMiscReg(regNum));
        assert(pkt->getSize() <= sizeof(RegVal));
        pkt->setData((uint8_t *)&data);
    } else {
        RegVal data = htole(tc->readMiscRegNoEffect(regNum));
        assert(pkt->getSize() <= sizeof(RegVal));
        pkt->writeData((uint8_t *)&data);
        tc->setMiscReg(regNum, letoh(data));
    }
    return Cycles(1);
}

} // anonymous namespace

Fault
TLB::translateInt(bool read, RequestPtr req, ThreadContext *tc)
{
    DPRINTF(TLB, "Addresses references internal memory.\n");
    Addr vaddr = req->getVaddr();
    Addr prefix = (vaddr >> 3) & IntAddrPrefixMask;
    if (prefix == IntAddrPrefixCPUID) {
        panic("CPUID memory space not yet implemented!\n");
    } else if (prefix == IntAddrPrefixMSR) {
        vaddr = (vaddr >> 3) & ~IntAddrPrefixMask;

        RegIndex regNum;
        if (!msrAddrToIndex(regNum, vaddr))
            return std::make_shared<GeneralProtection>(0);

        req->setPaddr(req->getVaddr());
        req->setLocalAccessor(
            [read,regNum](ThreadContext *tc, PacketPtr pkt)
            {
                return localMiscRegAccess(read, regNum, tc, pkt);
            }
        );

        return NoFault;
    } else if (prefix == IntAddrPrefixIO) {
        // TODO If CPL > IOPL or in virtual mode, check the I/O permission
        // bitmap in the TSS.

        Addr IOPort = vaddr & ~IntAddrPrefixMask;
        // Make sure the address fits in the expected 16 bit IO address
        // space.
        assert(!(IOPort & ~0xFFFF));
        if (IOPort == 0xCF8 && req->getSize() == 4) {
            req->setPaddr(req->getVaddr());
            req->setLocalAccessor(
                [read](ThreadContext *tc, PacketPtr pkt)
                {
                    return localMiscRegAccess(
                            read, misc_reg::PciConfigAddress, tc, pkt);
                }
            );
        } else if ((IOPort & ~mask(2)) == 0xCFC) {
            req->setFlags(Request::UNCACHEABLE | Request::STRICT_ORDER);
            Addr configAddress =
                tc->readMiscRegNoEffect(misc_reg::PciConfigAddress);
            if (bits(configAddress, 31, 31)) {
                req->setPaddr(PhysAddrPrefixPciConfig |
                        mbits(configAddress, 30, 2) |
                        (IOPort & mask(2)));
            } else {
                req->setPaddr(PhysAddrPrefixIO | IOPort);
            }
        } else {
            req->setFlags(Request::UNCACHEABLE | Request::STRICT_ORDER);
            req->setPaddr(PhysAddrPrefixIO | IOPort);
        }
        return NoFault;
    } else {
        panic("Access to unrecognized internal address space %#x.\n",
                prefix);
    }
}

Fault
TLB::finalizePhysical(const RequestPtr &req,
                      ThreadContext *tc, BaseMMU::Mode mode) const
{
    Addr paddr = req->getPaddr();

    if (m5opRange.contains(paddr)) {
        req->setFlags(Request::STRICT_ORDER);
        uint8_t func;
        pseudo_inst::decodeAddrOffset(paddr - m5opRange.start(), func);
        req->setLocalAccessor(
            [func, mode](ThreadContext *tc, PacketPtr pkt) -> Cycles
            {
                uint64_t ret;
                pseudo_inst::pseudoInst<X86PseudoInstABI, true>(tc, func, ret);
                if (mode == BaseMMU::Read)
                    pkt->setLE(ret);
                return Cycles(1);
            }
        );
    } else if (FullSystem) {
        // Check for an access to the local APIC
        LocalApicBase localApicBase =
            tc->readMiscRegNoEffect(misc_reg::ApicBase);
        AddrRange apicRange(localApicBase.base * PageBytes,
                            (localApicBase.base + 1) * PageBytes);

        if (apicRange.contains(paddr)) {
            // The Intel developer's manuals say the below restrictions apply,
            // but the linux kernel, because of a compiler optimization, breaks
            // them.
            /*
            // Check alignment
            if (paddr & ((32/8) - 1))
                return new GeneralProtection(0);
            // Check access size
            if (req->getSize() != (32/8))
                return new GeneralProtection(0);
            */
            // Force the access to be uncacheable.
            req->setFlags(Request::UNCACHEABLE | Request::STRICT_ORDER);
            req->setPaddr(x86LocalAPICAddress(tc->contextId(),
                                              paddr - apicRange.start()));
        }
    }

    return NoFault;
}

Fault
TLB::translate(const RequestPtr &req,
        ThreadContext *tc, BaseMMU::Translation *translation,
        BaseMMU::Mode mode, bool &delayedResponse, bool timing)
{
    Request::Flags flags = req->getFlags();
    int seg = flags & SegmentFlagMask;
    bool storeCheck = flags & Request::READ_MODIFY_WRITE;

    delayedResponse = false;

    // If this is true, we're dealing with a request to a non-memory address
    // space.
    if (seg == segment_idx::Ms) {
        return translateInt(mode == BaseMMU::Read, req, tc);
    }

    Addr vaddr = req->getVaddr();
    DPRINTF(TLB, "Translating vaddr %#x.\n", vaddr);

    HandyM5Reg m5Reg = tc->readMiscRegNoEffect(misc_reg::M5Reg);

    const Addr logAddrSize = (flags >> AddrSizeFlagShift) & AddrSizeFlagMask;
    const int addrSize = 8 << logAddrSize;
    const Addr addrMask = mask(addrSize);

    // If protected mode has been enabled...
    if (m5Reg.prot) {
        DPRINTF(TLB, "In protected mode.\n");
        // If we're not in 64-bit mode, do protection/limit checks
        if (m5Reg.mode != LongMode) {
            DPRINTF(TLB, "Not in long mode. Checking segment protection.\n");

            // CPUs won't know to use CS when building fetch requests, so we
            // need to override the value of "seg" here if this is a fetch.
            if (mode == BaseMMU::Execute)
                seg = segment_idx::Cs;

            SegAttr attr = tc->readMiscRegNoEffect(misc_reg::segAttr(seg));
            // Check for an unusable segment.
            if (attr.unusable) {
                DPRINTF(TLB, "Unusable segment.\n");
                return std::make_shared<GeneralProtection>(0);
            }
            bool expandDown = false;
            if (seg >= segment_idx::Es && seg <= segment_idx::Hs) {
                if (!attr.writable && (mode == BaseMMU::Write || storeCheck)) {
                    DPRINTF(TLB, "Tried to write to unwritable segment.\n");
                    return std::make_shared<GeneralProtection>(0);
                }
                if (!attr.readable && mode == BaseMMU::Read) {
                    DPRINTF(TLB, "Tried to read from unreadble segment.\n");
                    return std::make_shared<GeneralProtection>(0);
                }
                expandDown = attr.expandDown;

            }
            Addr base = tc->readMiscRegNoEffect(misc_reg::segBase(seg));
            Addr limit = tc->readMiscRegNoEffect(misc_reg::segLimit(seg));
            Addr offset;
            if (mode == BaseMMU::Execute)
                offset = vaddr - base;
            else
                offset = (vaddr - base) & addrMask;
            Addr endOffset = offset + req->getSize() - 1;
            if (expandDown) {
                DPRINTF(TLB, "Checking an expand down segment.\n");
                warn_once("Expand down segments are untested.\n");
                if (offset <= limit || endOffset <= limit)
                    return std::make_shared<GeneralProtection>(0);
            } else {
                if (offset > limit || endOffset > limit) {
                    DPRINTF(TLB, "Segment limit check failed, "
                            "offset = %#x limit = %#x.\n", offset, limit);
                    return std::make_shared<GeneralProtection>(0);
                }
            }
        }
        if (m5Reg.submode != SixtyFourBitMode && addrSize != 64)
            vaddr &= mask(32);
        // If paging is enabled, do the translation.
        if (m5Reg.paging) {
            DPRINTF(TLB, "Paging enabled.\n");
            // The vaddr already has the segment base applied.

            //Appending the pcid (last 12 bits of CR3) to the
            //page aligned vaddr if pcide is set
            CR4 cr4 = tc->readMiscRegNoEffect(misc_reg::Cr4);
            Addr pageAlignedVaddr = vaddr & (~mask(X86ISA::PageShift));
            CR3 cr3 = tc->readMiscRegNoEffect(misc_reg::Cr3);
            uint64_t pcid;

            if (cr4.pcide)
                pcid = cr3.pcid;
            else
                pcid = 0x000;

            pageAlignedVaddr = concAddrPcid(pageAlignedVaddr, pcid);
            TlbEntry *entry = lookup(pageAlignedVaddr);

            // --- ADD THIS L2 LOGIC ---
            if (!entry) {
                // It missed in L1. Let's check the L2!
                TlbEntry *l2_entry = l2_lookup(pageAlignedVaddr);

                if (l2_entry) {
                    // It hit in the L2!
                    DPRINTF(TLB, "SUCCESS: L2 TLB HIT for address %#x!\n", pageAlignedVaddr); // <-- ADD THIS LINE
                    // Copy it into the L1.
                    entry = insert(pageAlignedVaddr, *l2_entry, pcid);
                } else {
                    DPRINTF(TLB, "L2 TLB MISS for address %#x. Going to Walker...\n", pageAlignedVaddr); // <-- ADD THIS LINE
                }
            }
            // -------------------------

            switch (mode) {
                case BaseMMU::Read:
                    stats.rdAccesses++;
                    break;
                case BaseMMU::Write:
                    stats.wrAccesses++;
                    break;
                case BaseMMU::Execute:
                    stats.exAccesses++;
                    break;
                default:
                    panic("Invalid mode\n");
                    break;
            }
            if (!entry) {
                DPRINTF(TLB, "Handling a TLB miss for "
                        "address %#x at pc %#x.\n",
                        vaddr, tc->pcState().instAddr());
                switch (mode) {
                    case BaseMMU::Read:
                        stats.rdMisses++;
                        break;
                    case BaseMMU::Write:
                        stats.wrMisses++;
                        break;
                    case BaseMMU::Execute:
                        stats.exMisses++;
                        break;
                    default:
                        panic("Invalid mode\n");
                        break;
                }
                if (FullSystem) {
                    Fault fault = walker->start(tc, translation, req, mode);
                    if (timing || fault != NoFault) {
                        // This gets ignored in atomic mode.
                        delayedResponse = true;
                        return fault;
                    }
                    entry = lookup(pageAlignedVaddr);
                    assert(entry);
                } else {
                    Process *p = tc->getProcessPtr();
                    const EmulationPageTable::Entry *pte =
                        p->pTable->lookup(vaddr);
                    if (!pte) {
                        return std::make_shared<PageFault>(vaddr, true, mode,
                                                           true, false);
                    } else {
                        Addr alignedVaddr = p->pTable->pageAlign(vaddr);
                        DPRINTF(TLB, "Mapping %#x to %#x\n", alignedVaddr,
                                pte->paddr);
                        entry = insert(alignedVaddr, TlbEntry(
                                p->pTable->pid(), alignedVaddr, pte->paddr,
                                pte->flags & EmulationPageTable::Uncacheable,
                                pte->flags & EmulationPageTable::ReadOnly),
                                pcid);
                    }
                    DPRINTF(TLB, "Miss was serviced.\n");
                }
            }

            DPRINTF(TLB, "Entry found with paddr %#x, "
                    "doing protection checks.\n", entry->paddr);
            // Do paging protection checks.
            bool inUser = m5Reg.cpl == 3 && !(flags & CPL0FlagBit);
            CR0 cr0 = tc->readMiscRegNoEffect(misc_reg::Cr0);
            bool badWrite = (!entry->writable && (inUser || cr0.wp));
            if ((inUser && !entry->user) ||
                (mode == BaseMMU::Write && badWrite)) {
                // The page must have been present to get into the TLB in
                // the first place. We'll assume the reserved bits are
                // fine even though we're not checking them.
                return std::make_shared<PageFault>(vaddr, true, mode, inUser,
                                                   false);
            }
            if (storeCheck && badWrite) {
                // This would fault if this were a write, so return a page
                // fault that reflects that happening.
                return std::make_shared<PageFault>(
                    vaddr, true, BaseMMU::Write, inUser, false);
            }

            Addr paddr = entry->paddr | (vaddr & mask(entry->logBytes));
            DPRINTF(TLB, "Translated %#x -> %#x.\n", vaddr, paddr);
            req->setPaddr(paddr);
            if (entry->uncacheable)
                req->setFlags(Request::UNCACHEABLE | Request::STRICT_ORDER);
        } else {
            //Use the address which already has segmentation applied.
            DPRINTF(TLB, "Paging disabled.\n");
            DPRINTF(TLB, "Translated %#x -> %#x.\n", vaddr, vaddr);
            req->setPaddr(vaddr);
        }
    } else {
        // Real mode
        DPRINTF(TLB, "In real mode.\n");
        DPRINTF(TLB, "Translated %#x -> %#x.\n", vaddr, vaddr);
        req->setPaddr(vaddr);
    }

    return finalizePhysical(req, tc, mode);
}

Fault
TLB::translateAtomic(const RequestPtr &req, ThreadContext *tc,
    BaseMMU::Mode mode)
{
    bool delayedResponse;
    // CLFLUSHOPT/WB/FLUSH should be treated as read for protection checks
    if (req->isCacheClean())
        mode = BaseMMU::Read;
    return TLB::translate(req, tc, NULL, mode, delayedResponse, false);
}

Fault
TLB::translateFunctional(const RequestPtr &req, ThreadContext *tc,
    BaseMMU::Mode mode)
{
    // CLFLUSHOPT/WB/FLUSH should be treated as read for protection checks
    if (req->isCacheClean())
        mode = BaseMMU::Read;
    unsigned logBytes;
    const Addr vaddr = req->getVaddr();
    Addr addr = vaddr;
    Addr paddr = 0;
    if (FullSystem) {
        Fault fault = walker->startFunctional(tc, addr, logBytes, mode);
        if (fault != NoFault)
            return fault;
        paddr = insertBits(addr, logBytes - 1, 0, vaddr);
    } else {
        Process *process = tc->getProcessPtr();
        const auto *pte = process->pTable->lookup(vaddr);

        if (!pte && mode != BaseMMU::Execute) {
            // Check if we just need to grow the stack.
            if (process->fixupFault(vaddr)) {
                // If we did, lookup the entry for the new page.
                pte = process->pTable->lookup(vaddr);
            }
        }

        if (!pte)
            return std::make_shared<PageFault>(vaddr, true, mode, true, false);

        paddr = pte->paddr | process->pTable->pageOffset(vaddr);
    }
    DPRINTF(TLB, "Translated (functional) %#x -> %#x.\n", vaddr, paddr);
    req->setPaddr(paddr);
    return NoFault;
}

void
TLB::translateTiming(const RequestPtr &req, ThreadContext *tc,
    BaseMMU::Translation *translation, BaseMMU::Mode mode)
{
    bool delayedResponse;
    assert(translation);
    // CLFLUSHOPT/WB/FLUSH should be treated as read for protection checks
    BaseMMU::Mode orig_mode = mode;
    if (req->isCacheClean())
        mode = BaseMMU::Read;
    Fault fault =
        TLB::translate(req, tc, translation, mode, delayedResponse, true);
    if (!delayedResponse)
        translation->finish(fault, req, tc, orig_mode);
    else
        translation->markDelayed();
}

Walker *
TLB::getWalker()
{
    return walker;
}

TLB::TlbStats::TlbStats(statistics::Group *parent)
    : statistics::Group(parent),
      ADD_STAT(rdAccesses, statistics::units::Count::get(),
               "TLB accesses on read requests"),
      ADD_STAT(wrAccesses, statistics::units::Count::get(),
               "TLB accesses on write requests"),
      ADD_STAT(exAccesses, statistics::units::Count::get(),
               "TLB accesses on execute (instr) requests"),
      ADD_STAT(rdMisses, statistics::units::Count::get(),
               "TLB misses on read requests"),
      ADD_STAT(wrMisses, statistics::units::Count::get(),
               "TLB misses on write requests"),
      ADD_STAT(exMisses, statistics::units::Count::get(),
               "TLB misses on execute (instr) requests")
{
}

void
TLB::serialize(CheckpointOut &cp) const
{
    // Only store the entries in use.
    uint32_t _size = size - freeList.size();
    SERIALIZE_SCALAR(_size);
    SERIALIZE_SCALAR(lruSeq);

    // FIX (checkpoint bug, TLB_IMPLEMENTATION_AUDIT.md Approach 3 #5): the
    // original serialize()/unserialize() only covered L1, so a checkpoint
    // restore produced an empty L2 under a populated L1, violating the
    // inclusive invariant immediately (every restored L1 entry lacked an
    // L2 copy). Save the L2 geometry and contents too.
    //
    // gem5's checkpoint file is positional/INI-style: every scalar written
    // after a child serializeSection() call physically lands inside that
    // child's block, not back in this object's own section. All of this
    // object's own scalars (L1's and L2's) must therefore be written here,
    // before the Entry%d/L2Entry%d subsections are opened below - do not
    // move SERIALIZE_SCALAR calls after either loop.
    SERIALIZE_SCALAR(l2Sets);
    SERIALIZE_SCALAR(l2Ways);
    SERIALIZE_SCALAR(l2_lruSeq);
    uint32_t l2Total = l2Sets * l2Ways;
    uint32_t l2Count = 0;
    for (uint32_t i = 0; i < l2Total; i++)
        if (l2Valid[i])
            l2Count++;
    SERIALIZE_SCALAR(l2Count);

    uint32_t _count = 0;
    for (uint32_t x = 0; x < size; x++) {
        if (tlb[x].trieHandle != NULL)
            tlb[x].serializeSection(cp, csprintf("Entry%d", _count++));
    }

    // No explicit slot index is stored: unserialize() recomputes each
    // entry's set from its own restored vaddr (l2SetIndex) and drops it
    // into any empty way there. A scalar written between two sibling
    // L2Entry%d sections would suffer the same misattribution as above,
    // so this loop writes nothing but child sections.
    uint32_t k = 0;
    for (uint32_t i = 0; i < l2Total; i++) {
        if (!l2Valid[i])
            continue;
        l2Entry[i].serializeSection(cp, csprintf("L2Entry%d", k++));
    }
}

void
TLB::unserialize(CheckpointIn &cp)
{
    // Do not allow to restore with a smaller tlb.
    uint32_t _size;
    UNSERIALIZE_SCALAR(_size);
    if (_size > size) {
        fatal("TLB size less than the one in checkpoint!");
    }

    UNSERIALIZE_SCALAR(lruSeq);

    // FIX: restore L2 as well (see serialize() above). Read order mirrors
    // the write order there exactly - all of this object's own scalars
    // first, before any Entry%d/L2Entry%d child section is opened, since
    // gem5's checkpoint reader tracks "current section" the same
    // positional way the writer does.
    //
    // The L2 geometry must match the running configuration (same
    // TLB_L2_GEOM); unlike L1 size, a smaller/larger/reshaped L2 cannot be
    // remapped onto the current set/way layout without changing which
    // entries alias, so we fatal instead of guessing.
    //
    // NOTE: UNSERIALIZE_SCALAR(x) keys the checkpoint by the stringified
    // variable name, so it must read back the same key serialize() wrote
    // (l2Sets/l2Ways) rather than a differently-named local; paramIn lets
    // the key stay "l2Sets"/"l2Ways" while the local stays cpL2Sets/cpL2Ways.
    uint32_t cpL2Sets, cpL2Ways;
    paramIn(cp, "l2Sets", cpL2Sets);
    paramIn(cp, "l2Ways", cpL2Ways);
    if (cpL2Sets != l2Sets || cpL2Ways != l2Ways) {
        fatal("TLB L2 geometry in checkpoint (%ux%u) does not match the "
              "running configuration (%ux%u); restore with the same "
              "TLB_L2_GEOM used to create the checkpoint.",
              cpL2Sets, cpL2Ways, l2Sets, l2Ways);
    }
    UNSERIALIZE_SCALAR(l2_lruSeq);
    uint32_t l2Count;
    UNSERIALIZE_SCALAR(l2Count);

    for (uint32_t x = 0; x < _size; x++) {
        TlbEntry *newEntry = freeList.front();
        freeList.pop_front();

        newEntry->unserializeSection(cp, csprintf("Entry%d", x));
        newEntry->trieHandle = trie.insert(newEntry->vaddr,
            TlbEntryTrie::MaxBits - newEntry->logBytes, newEntry);
    }

    // Mirror serialize(): no stored slot index. Each entry's own vaddr
    // (restored by unserializeSection) determines its set via the same
    // hash used at runtime; drop it into any empty way of that set. This
    // never collides: geometry matched above, and l2Count can't exceed
    // l2Total, so some way in the correct set is always free when visited
    // in this order.
    std::fill(l2Valid.begin(), l2Valid.end(), 0);
    TlbEntry tmp;
    for (uint32_t k = 0; k < l2Count; k++) {
        tmp.unserializeSection(cp, csprintf("L2Entry%d", k));
        uint32_t set = l2SetIndex(tmp.vaddr >> X86ISA::PageShift);
        uint32_t base = set * l2Ways;
        uint32_t w = 0;
        for (; w < l2Ways; w++)
            if (!l2Valid[base + w])
                break;
        if (w == l2Ways)
            fatal("TLB checkpoint restore: L2 set %u has more entries than "
                  "ways (%u); corrupt checkpoint or geometry mismatch.",
                  set, l2Ways);
        l2Entry[base + w] = tmp;
        l2Valid[base + w] = 1;
    }
}

Port *
TLB::getTableWalkerPort()
{
    return &walker->getPort("port");
}

} // namespace X86ISA
} // namespace gem5
