TLB::TLB(const Params &p)
    : BaseTLB(p), configAddress(0), size(p.size),
      tlb(size), lruSeq(0),
      l2_lruSeq(0), // <--- MODIFIED FOR SET-ASSOCIATIVE
      m5opRange(p.system->m5opRange()), stats(this)
{
    if (!size)
        fatal("TLBs must have a non-zero size.\n");

    for (int x = 0; x < size; x++) {
        tlb[x].trieHandle = NULL;
        freeList.push_back(&tlb[x]);
    }

    // --- UNIFIED SET-ASSOCIATIVE L2 SETUP LOOP (ISCA 2020) ---
    l2_sets.resize(L2_SETS);
    for (int i = 0; i < L2_SETS; i++) {
        for (int j = 0; j < L2_WAYS; j++) {
            l2_sets[i].ways[j].type = L2_TYPE_EMPTY;
            l2_sets[i].ways[j].lruSeq = 0;
        }
    }
    // --- CoLT-FA INITIALIZATION ---
    colt_fa_lruSeq = 0;
    for (int i = 0; i < COLT_FA_ENTRIES; i++) {
        colt_fa_array[i].valid = false;
        colt_fa_array[i].vpn_base = 0;
        colt_fa_array[i].paddr_base = 0;
        colt_fa_array[i].coal_len = 0;
        colt_fa_array[i].lruSeq = 0;
        colt_fa_array[i].pcid = 0;
        colt_fa_array[i].global = false;
        colt_fa_array[i].uncacheable = false;
        colt_fa_array[i].read_only = false;
    }
    // ----------------------------------------------

    walker = p.walker;
    walker->setTLB(this);
}

// --- CoLT-FA HELPER FUNCTIONS (MICRO 2012) ---
TlbEntry *TLB::colt_fa_lookup(Addr va, uint64_t pcid, bool update_lru) {
    stats.coltFaLookups++;
    Addr clean_vpn = (va & ~((Addr)0xFFF)) & 0xFFFFFFFFFFFFF;
    for (int i = 0; i < COLT_FA_ENTRIES; i++) {
        if (colt_fa_array[i].valid &&
            (colt_fa_array[i].global || colt_fa_array[i].pcid == pcid)) {
            Addr base = colt_fa_array[i].vpn_base & ~((Addr)0xFFF);
            Addr limit = base + ((Addr)colt_fa_array[i].coal_len * X86ISA::PageBytes);
            if (clean_vpn >= base && clean_vpn < limit) {
                stats.coltFaHits++;
                if (update_lru) {
                    colt_fa_array[i].lruSeq = ++colt_fa_lruSeq;
                }
                Addr offset_pages = (clean_vpn - base) >> X86ISA::PageShift;
                temp_colt_entry.vaddr = va;
                temp_colt_entry.paddr = colt_fa_array[i].paddr_base + (offset_pages * X86ISA::PageBytes);
                temp_colt_entry.uncacheable = colt_fa_array[i].uncacheable;
                temp_colt_entry.writable = !colt_fa_array[i].read_only;
                temp_colt_entry.logBytes = X86ISA::PageShift;
                temp_colt_entry.user = true;
                temp_colt_entry.noExec = false;
                temp_colt_entry.global = colt_fa_array[i].global;
                return &temp_colt_entry;
            }
        }
    }
    return NULL;
}

void TLB::colt_fa_insert(Addr base_vpn, Addr base_paddr, uint8_t coal_len,
                        bool uncacheable, bool read_only, uint64_t pcid, bool global) {
    for (int i = 0; i < COLT_FA_ENTRIES; i++) {
        if (colt_fa_array[i].valid &&
            (colt_fa_array[i].vpn_base & ~((Addr)0xFFF)) == (base_vpn & ~((Addr)0xFFF)) &&
            (colt_fa_array[i].global == global && colt_fa_array[i].pcid == pcid)) {
            colt_fa_array[i].paddr_base = base_paddr;
            colt_fa_array[i].coal_len = coal_len;
            colt_fa_array[i].uncacheable = uncacheable;
            colt_fa_array[i].read_only = read_only;
            colt_fa_array[i].lruSeq = ++colt_fa_lruSeq;
            return;
        }
    }
    int victim = 0;
    for (int i = 0; i < COLT_FA_ENTRIES; i++) {
        if (!colt_fa_array[i].valid) {
            victim = i;
            break;
        }
        if (colt_fa_array[i].lruSeq < colt_fa_array[victim].lruSeq) {
            victim = i;
        }
    }
    colt_fa_array[victim].valid = true;
    colt_fa_array[victim].vpn_base = base_vpn & ~((Addr)0xFFF);
    colt_fa_array[victim].paddr_base = base_paddr;
    colt_fa_array[victim].coal_len = coal_len;
    colt_fa_array[victim].uncacheable = uncacheable;
    colt_fa_array[victim].read_only = read_only;
    colt_fa_array[victim].pcid = pcid;
    colt_fa_array[victim].global = global;
    colt_fa_array[victim].lruSeq = ++colt_fa_lruSeq;
}

// --- DECOUPLED IN-TLB BITMAP CACHE HELPERS (ISCA 2020 Section IV-C) ---
bool TLB::probe_bitmap_cache(Addr vpn_2mb, uint8_t chunk_idx, uint64_t pcid, uint32_t *cached_bits) {
    uint32_t set_idx = xor_7_hash(vpn_2mb ^ chunk_idx);
    for (int w = 0; w < L2_WAYS; w++) {
        if (l2_sets[set_idx].ways[w].type == L2_TYPE_BITMAP &&
            l2_sets[set_idx].ways[w].bmp.vpn_2mb == vpn_2mb &&
            l2_sets[set_idx].ways[w].bmp.chunk_idx == chunk_idx &&
            (l2_sets[set_idx].ways[w].bmp.global || l2_sets[set_idx].ways[w].bmp.pcid == pcid)) {
            l2_sets[set_idx].ways[w].lruSeq = ++l2_lruSeq;
            if (cached_bits) {
                *cached_bits = l2_sets[set_idx].ways[w].bmp.bitmap_bits;
            }
            return true;
        }
    }
    return false;
}

void TLB::install_bitmap_cache(Addr vpn_2mb, uint8_t chunk_idx, uint32_t bits, uint64_t pcid, bool global) {
    uint32_t set_idx = xor_7_hash(vpn_2mb ^ chunk_idx);
    stats.decoupledBitmapInstalls++;

    // Check if already present
    for (int w = 0; w < L2_WAYS; w++) {
        if (l2_sets[set_idx].ways[w].type == L2_TYPE_BITMAP &&
            l2_sets[set_idx].ways[w].bmp.vpn_2mb == vpn_2mb &&
            l2_sets[set_idx].ways[w].bmp.chunk_idx == chunk_idx &&
            (l2_sets[set_idx].ways[w].bmp.global == global && l2_sets[set_idx].ways[w].bmp.pcid == pcid)) {
            l2_sets[set_idx].ways[w].bmp.bitmap_bits = bits;
            l2_sets[set_idx].ways[w].lruSeq = ++l2_lruSeq;
            return;
        }
    }

    // Find victim way (LRU or empty)
    int victim_way = 0;
    for (int w = 0; w < L2_WAYS; w++) {
        if (l2_sets[set_idx].ways[w].type == L2_TYPE_EMPTY) {
            victim_way = w;
            break;
        }
        if (l2_sets[set_idx].ways[w].lruSeq < l2_sets[set_idx].ways[victim_way].lruSeq) {
            victim_way = w;
        }
    }

    // If victim was a translation entry, track eviction caused by bitmap caching
    if (l2_sets[set_idx].ways[victim_way].type == L2_TYPE_TRANSLATION) {
        stats.decoupledBitmapEvictedTranslations++;
        DPRINTF(TLB, "BITMAP CAPACITY CONTENION: Decoupled bitmap evicted translation %#x at set %d way %d!\n",
                l2_sets[set_idx].ways[victim_way].trans.vpn_2mb << 21, set_idx, victim_way);
    }

    l2_sets[set_idx].ways[victim_way].type = L2_TYPE_BITMAP;
    l2_sets[set_idx].ways[victim_way].bmp.vpn_2mb = vpn_2mb;
    l2_sets[set_idx].ways[victim_way].bmp.chunk_idx = chunk_idx;
    l2_sets[set_idx].ways[victim_way].bmp.bitmap_bits = bits;
    l2_sets[set_idx].ways[victim_way].bmp.pcid = pcid;
    l2_sets[set_idx].ways[victim_way].bmp.global = global;
    l2_sets[set_idx].ways[victim_way].lruSeq = ++l2_lruSeq;
}

// --- SET-ASSOCIATIVE L2 HELPER FUNCTIONS (PERFORATED PAGES) ---
TlbEntry *TLB::l2_lookup(Addr va, uint64_t pcid, bool update_lru) {
    Addr clean_va = va & ~((Addr)0xFFF); // 4KB aligned
    Addr vpn_2mb = clean_va >> 21;
    uint32_t set_idx = xor_7_hash(vpn_2mb);
    uint32_t offset_4k = (clean_va >> X86ISA::PageShift) & 0x1FF;
    uint32_t coarse_idx = offset_4k / 64; // 8 chunks of 64 pages (256KB each)
    uint8_t sub_chunk_idx = offset_4k / 32; // 16 chunks of 32 pages for 32-bit bitmap

    for (int i = 0; i < L2_WAYS; i++) {
        if (l2_sets[set_idx].ways[i].type == L2_TYPE_TRANSLATION &&
            l2_sets[set_idx].ways[i].trans.vpn_2mb == vpn_2mb &&
            (l2_sets[set_idx].ways[i].trans.global || l2_sets[set_idx].ways[i].trans.pcid == pcid)) {

            stats.coarseFilterLookups++;
            uint8_t filter_state = l2_sets[set_idx].ways[i].trans.coarse_filter[coarse_idx];

            if (filter_state == COARSE_EMPTY) {
                // Tier 1: Early reject - chunk has no valid pages
                stats.coarseFilterEarlyRejects++;
                stats.estLookupCyclesSaved += 8; // 1 cycle filter vs 9 cycle L2 access
                stats.estDynamicEnergyUnitsSaved += 87;
                return NULL;
            }

            if (filter_state == COARSE_CLEAN) {
                // Tier 1: Fast hit - chunk has no holes, bypass secondary bitmap
                stats.coarseFilterCleanHits++;
                stats.estLookupCyclesSaved += 9; // Bypassed secondary L2 TLB bitmap access
                stats.estDynamicEnergyUnitsSaved += 80;

                if (update_lru) l2_sets[set_idx].ways[i].lruSeq = ++l2_lruSeq;
                temp_shp_entry.vaddr = clean_va;
                temp_shp_entry.paddr = l2_sets[set_idx].ways[i].trans.paddrs[offset_4k];
                temp_shp_entry.uncacheable = l2_sets[set_idx].ways[i].trans.uncacheable[offset_4k];
                temp_shp_entry.writable = !l2_sets[set_idx].ways[i].trans.read_only[offset_4k];
                temp_shp_entry.logBytes = X86ISA::PageShift;
                temp_shp_entry.user = true;
                temp_shp_entry.noExec = false;
                temp_shp_entry.global = l2_sets[set_idx].ways[i].trans.global;
                return &temp_shp_entry;
            }

            // Tier 2: COARSE_HOLEY - must access secondary bitmap
            stats.secondaryBitmapAccesses++;

            // Section IV-C: Probe decoupled in-TLB bitmap cache
            uint32_t bmp_word = 0;
            bool bmp_hit = probe_bitmap_cache(vpn_2mb, sub_chunk_idx, pcid, &bmp_word);
            if (bmp_hit) {
                stats.decoupledBitmapCacheHits++;
            } else {
                stats.decoupledBitmapCacheMisses++;
                // On-demand fetch of 32-bit sub-bitmap from translation entry into L2 TLB
                for (int b = 0; b < 32; b++) {
                    if (l2_sets[set_idx].ways[i].trans.sub_valid[sub_chunk_idx * 32 + b]) {
                        bmp_word |= (1U << b);
                    }
                }
                install_bitmap_cache(vpn_2mb, sub_chunk_idx, bmp_word, pcid,
                                    l2_sets[set_idx].ways[i].trans.global);
            }

            // USE BITMAP PAYLOAD TO DECIDE MEMBERSHIP
            uint32_t bit_pos = offset_4k % 32;
            bool is_valid = (bmp_word & (1U << bit_pos)) != 0;

            if (is_valid) {
                stats.l2BitmapHits++;
                if (update_lru) l2_sets[set_idx].ways[i].lruSeq = ++l2_lruSeq;
                temp_shp_entry.vaddr = clean_va;
                temp_shp_entry.paddr = l2_sets[set_idx].ways[i].trans.paddrs[offset_4k];
                temp_shp_entry.uncacheable = l2_sets[set_idx].ways[i].trans.uncacheable[offset_4k];
                temp_shp_entry.writable = !l2_sets[set_idx].ways[i].trans.read_only[offset_4k];
                temp_shp_entry.logBytes = X86ISA::PageShift;
                temp_shp_entry.user = true;
                temp_shp_entry.noExec = false;
                temp_shp_entry.global = l2_sets[set_idx].ways[i].trans.global;
                return &temp_shp_entry;
            } else {
                stats.l2BitmapHoleMisses++;
                return NULL;
            }
        }
    }
    return NULL;
}

void
TLB::l2_remove(Addr va, uint64_t asn)
{
    Addr clean_va = va & ~((Addr)0xFFF);
    Addr vpn_2mb = clean_va >> 21;
    uint32_t set_idx = xor_7_hash(vpn_2mb);
    uint32_t offset_4k = (clean_va >> X86ISA::PageShift) & 0x1FF;
    uint32_t coarse_idx = offset_4k / 64;
    uint8_t sub_chunk_idx = offset_4k / 32;

    for (int way = 0; way < L2_WAYS; way++) {
        UnifiedL2Way &entry = l2_sets[set_idx].ways[way];
        if (entry.type == L2_TYPE_TRANSLATION &&
            entry.trans.vpn_2mb == vpn_2mb &&
            (entry.trans.global || asn == 0 || entry.trans.pcid == asn)) {
            if (entry.trans.sub_valid[offset_4k]) {
                entry.trans.sub_valid[offset_4k] = false;
                // Recompute coarse filter for this chunk
                int count = 0;
                int start_idx = coarse_idx * 64;
                for (int k = start_idx; k < start_idx + 64; k++) {
                    if (entry.trans.sub_valid[k]) count++;
                }
                if (count == 64) {
                    entry.trans.coarse_filter[coarse_idx] = COARSE_CLEAN;
                } else if (count > 0) {
                    entry.trans.coarse_filter[coarse_idx] = COARSE_HOLEY;
                } else {
                    entry.trans.coarse_filter[coarse_idx] = COARSE_EMPTY;
                }

                // Check if any pages remain valid in the 2MB region
                bool any_valid = false;
                for (int k = 0; k < 512; k++) {
                    if (entry.trans.sub_valid[k]) {
                        any_valid = true;
                        break;
                    }
                }
                if (!any_valid) {
                    entry.type = L2_TYPE_EMPTY;
                    entry.lruSeq = 0;
                }
            }
        }
    }

    uint32_t bitmap_set = xor_7_hash(vpn_2mb ^ sub_chunk_idx);
    for (int way = 0; way < L2_WAYS; way++) {
        UnifiedL2Way &entry = l2_sets[bitmap_set].ways[way];
        if (entry.type == L2_TYPE_BITMAP &&
            entry.bmp.vpn_2mb == vpn_2mb &&
            entry.bmp.chunk_idx == sub_chunk_idx &&
            (entry.bmp.global || asn == 0 || entry.bmp.pcid == asn)) {
            entry.type = L2_TYPE_EMPTY;
            entry.lruSeq = 0;
        }
    }

    for (int i = 0; i < COLT_FA_ENTRIES; i++) {
        ColtFaEntry &entry = colt_fa_array[i];
        Addr base = entry.vpn_base & ~((Addr)0xFFF);
        Addr end = base +
            ((Addr)entry.coal_len * X86ISA::PageBytes);
        if (entry.valid && clean_va >= base && clean_va < end &&
            (entry.global || asn == 0 || entry.pcid == asn)) {
            entry.valid = false;
        }
    }
}

TlbEntry *TLB::l2_insert(Addr vpn, const TlbEntry &entry, uint64_t pcid) {
    Addr clean_va = vpn & ~((Addr)0xFFF);
    Addr vpn_2mb = clean_va >> 21;
    uint32_t set_idx = xor_7_hash(vpn_2mb);
    uint32_t offset_4k = (clean_va >> X86ISA::PageShift) & 0x1FF;
    uint32_t coarse_idx = offset_4k / 64;

    // Check if 2MB region already exists in this set for this pcid/global status
    for (int i = 0; i < L2_WAYS; i++) {
        if (l2_sets[set_idx].ways[i].type == L2_TYPE_TRANSLATION &&
            l2_sets[set_idx].ways[i].trans.vpn_2mb == vpn_2mb &&
            (l2_sets[set_idx].ways[i].trans.global == entry.global &&
             l2_sets[set_idx].ways[i].trans.pcid == pcid)) {

            // Region exists! Coalesce it!
            l2_sets[set_idx].ways[i].trans.sub_valid[offset_4k] = true;
            l2_sets[set_idx].ways[i].trans.paddrs[offset_4k] = entry.paddr;
            l2_sets[set_idx].ways[i].trans.uncacheable[offset_4k] = entry.uncacheable;
            l2_sets[set_idx].ways[i].trans.read_only[offset_4k] = !entry.writable;
            l2_sets[set_idx].ways[i].lruSeq = ++l2_lruSeq;

            // Recompute coarse filter for this chunk
            int count = 0;
            int start_idx = coarse_idx * 64;
            for (int k = start_idx; k < start_idx + 64; k++) {
                if (l2_sets[set_idx].ways[i].trans.sub_valid[k]) count++;
            }
            if (count == 64) {
                l2_sets[set_idx].ways[i].trans.coarse_filter[coarse_idx] = COARSE_CLEAN;
            } else if (count > 0) {
                l2_sets[set_idx].ways[i].trans.coarse_filter[coarse_idx] = COARSE_HOLEY;
            } else {
                l2_sets[set_idx].ways[i].trans.coarse_filter[coarse_idx] = COARSE_EMPTY;
            }

            DPRINTF(TLB, "SHP Coalescing: Added %#x to existing 2MB Sparse Page %#x (chunk %d count %d)\n",
                    clean_va, vpn_2mb << 21, coarse_idx, count);
            return NULL;
        }
    }

    // Evict LRU in THIS set
    int lru_way = 0;
    for (int i = 0; i < L2_WAYS; i++) {
        if (l2_sets[set_idx].ways[i].type == L2_TYPE_EMPTY) {
            lru_way = i;
            break;
        }
        if (l2_sets[set_idx].ways[i].lruSeq < l2_sets[set_idx].ways[lru_way].lruSeq) {
            lru_way = i;
        }
    }

    // Overwrite the victim in the L2 set
    l2_sets[set_idx].ways[lru_way].type = L2_TYPE_TRANSLATION;
    l2_sets[set_idx].ways[lru_way].lruSeq = ++l2_lruSeq;

    for(int j = 0; j < 512; j++) {
        l2_sets[set_idx].ways[lru_way].trans.sub_valid[j] = false;
        l2_sets[set_idx].ways[lru_way].trans.paddrs[j] = 0;
        l2_sets[set_idx].ways[lru_way].trans.uncacheable[j] = false;
        l2_sets[set_idx].ways[lru_way].trans.read_only[j] = false;
    }
    for(int j = 0; j < 8; j++) {
        l2_sets[set_idx].ways[lru_way].trans.coarse_filter[j] = COARSE_EMPTY;
    }

    l2_sets[set_idx].ways[lru_way].trans.vpn_2mb = vpn_2mb;
    l2_sets[set_idx].ways[lru_way].trans.pcid = pcid;
    l2_sets[set_idx].ways[lru_way].trans.global = entry.global;
    l2_sets[set_idx].ways[lru_way].trans.sub_valid[offset_4k] = true;
    l2_sets[set_idx].ways[lru_way].trans.coarse_filter[coarse_idx] = COARSE_HOLEY; // Initial page
    l2_sets[set_idx].ways[lru_way].trans.paddrs[offset_4k] = entry.paddr;
    l2_sets[set_idx].ways[lru_way].trans.uncacheable[offset_4k] = entry.uncacheable;
    l2_sets[set_idx].ways[lru_way].trans.read_only[offset_4k] = !entry.writable;

    DPRINTF(TLB, "SHP Alloc: Created new 2MB Sparse Page for %#x at way %d\n", vpn_2mb << 21, lru_way);
    return NULL;
}
