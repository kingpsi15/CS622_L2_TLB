// NINE (neither-inclusive-nor-exclusive) set-associative L2 TLB - FIXED.
//
// Runtime variants (read from the environment once, in the TLB constructor;
// one gem5.opt binary covers all of them):
//   NINE_L2_SETS   : number of L2 sets, power of 2, 1..4096 (default 128)
//   NINE_L2_WAYS   : L2 associativity, 1..16                (default 4)
//   NINE_L2_HASH   : set-index hash: 0=xor-fold(default) 1=low-bits 2=multiplicative
//   NINE_L2_REPL   : L2 replacement: 0=LRU(default) 1=FIFO 2=random
//   NINE_L2_INSERT_ON_HIT : 1=re-touch L2 copy on an L2->L1 promotion (default), 0=leave L2 LRU state alone
//   NINE_L1_SIZE   : overrides the SimObject's L1 'size' param when set (>0)
// See tlb.cc.nine.fixed top-of-file comment for what each bug fix changes.

#ifndef __ARCH_X86_TLB_HH__
#define __ARCH_X86_TLB_HH__

#include <list>
#include <vector>

#include "arch/generic/tlb.hh"
#include "arch/x86/pagetable.hh"
#include "base/trie.hh"
#include "mem/request.hh"
#include "params/X86TLB.hh"
#include "sim/stats.hh"

namespace gem5
{

class ThreadContext;

namespace X86ISA
{
    class Walker;

    class TLB : public BaseTLB
    {
      protected:
        friend class Walker;

        typedef std::list<TlbEntry *> EntryList;

        uint32_t configAddress;

      public:

        typedef X86TLBParams Params;
        TLB(const Params &p);

        void takeOverFrom(BaseTLB *otlb) override {}

        TlbEntry *lookup(Addr va, bool update_lru = true);

        void setConfigAddress(uint32_t addr);
        //concatenate Page Addr and pcid
        inline Addr concAddrPcid(Addr vpn, uint64_t pcid)
        {
          return (vpn | pcid);
        }

      protected:

        EntryList::iterator lookupIt(Addr va, bool update_lru = true);

        Walker * walker;

      public:
        Walker *getWalker();

        void flushAll() override;

        void flushNonGlobal();

        void demapPage(Addr va, uint64_t asn) override;

      protected:
        uint32_t size;
        std::vector<TlbEntry> tlb;
        EntryList freeList;
        TlbEntryTrie trie;
        uint64_t lruSeq;

        // --- NINE set-associative L2: runtime-configurable geometry ---
        // (FIX: these used to be compile-time 'static const' constants with
        // no way to sweep geometry without a rebuild, and the per-set fixed
        // C arrays made that impossible anyway; now a flat vector sized at
        // construction time from the environment.)
        uint32_t l2NumSets;
        uint32_t l2NumWays;
        uint32_t l2HashPolicy;   // 0=xor-fold 1=low-bits 2=multiplicative
        uint32_t l2ReplPolicy;   // 0=LRU 1=FIFO 2=random
        bool     l2InsertOnHit;  // re-touch L2 entry on L1 promotion

        std::vector<TlbEntry> l2_entries; // flat: [set*l2NumWays + way]
        std::vector<bool>     l2_valid;
        std::vector<uint64_t> l2_fifoSeq; // insertion order, for FIFO replacement
        uint64_t l2_lruSeq;
        uint64_t l2_fifoCounter;

        inline uint32_t
        l2_hash(Addr vpn)
        {
            // l2NumSets is enforced to be a power of two (see ctor).
            uint32_t setBits = 0;
            for (uint32_t n = l2NumSets; n > 1; n >>= 1) setBits++;
            uint32_t m = l2NumSets - 1;
            switch (l2HashPolicy) {
              case 1: // low-bits only
                return (uint32_t)(vpn & m);
              case 2: { // multiplicative (Knuth) mixing before folding
                uint64_t h = (uint64_t)vpn * 2654435761u;
                return (uint32_t)((h >> 13) & m);
              }
              default: { // xor-fold (same spirit as the original xor_7_hash,
                         // generalized to any power-of-two set count)
                uint32_t hi = (uint32_t)((vpn >> setBits) & m);
                uint32_t lo = (uint32_t)(vpn & m);
                return hi ^ lo;
              }
            }
        }

        // --- L2 helper functions (FIX: l2_remove now takes the ASN/PCID so
        // it only removes the translation for the address space that is
        // actually being demapped; see .cc for details). ---
        TlbEntry *l2_lookup(Addr va, bool update_lru = true);
        TlbEntry *l2_insert(Addr vpn, const TlbEntry &entry, uint64_t pcid);
        void l2_remove(Addr va, uint64_t asn);
        void l2_flushAll();
        void l2_flushNonGlobal();

        AddrRange m5opRange;

        struct TlbStats : public statistics::Group
        {
            TlbStats(statistics::Group *parent);

            statistics::Scalar rdAccesses;
            statistics::Scalar wrAccesses;
            statistics::Scalar exAccesses;
            statistics::Scalar rdMisses;
            statistics::Scalar wrMisses;
            statistics::Scalar exMisses;
            // FIX: the original NINE SA code never counted L2 hits/promotions
            // at all, so there was no way to tell a working L2 apart from a
            // dead one without the external checker.
            statistics::Scalar l2Hits;
            statistics::Scalar l2Insertions;
            statistics::Scalar l2Evictions;
        } stats;

        Fault translateInt(bool read, RequestPtr req, ThreadContext *tc);

        Fault translate(const RequestPtr &req, ThreadContext *tc,
                BaseMMU::Translation *translation, BaseMMU::Mode mode,
                bool &delayedResponse, bool timing);

      public:

        void evictLRU();

        uint64_t
        nextSeq()
        {
            return ++lruSeq;
        }

        Fault translateAtomic(
            const RequestPtr &req, ThreadContext *tc,
            BaseMMU::Mode mode) override;
        Fault translateFunctional(
            const RequestPtr &req, ThreadContext *tc,
            BaseMMU::Mode mode) override;
        void translateTiming(
            const RequestPtr &req, ThreadContext *tc,
            BaseMMU::Translation *translation, BaseMMU::Mode mode) override;

        /**
         * Do post-translation physical address finalization.
         *
         * Some addresses, for example requests going to the APIC,
         * need post-translation updates. Such physical addresses are
         * remapped into a "magic" part of the physical address space
         * by this method.
         *
         * @param req Request to updated in-place.
         * @param tc Thread context that created the request.
         * @param mode Request type (read/write/execute).
         * @return A fault on failure, NoFault otherwise.
         */
        Fault finalizePhysical(const RequestPtr &req, ThreadContext *tc,
                               BaseMMU::Mode mode) const override;

        TlbEntry *insert(Addr vpn, const TlbEntry &entry, uint64_t pcid);

        // Checkpointing
        // FIX: original NINE SA serialize/unserialize only covered the L1
        // array; the L2 state silently vanished across a checkpoint
        // restore. Now both are serialized together.
        void serialize(CheckpointOut &cp) const override;
        void unserialize(CheckpointIn &cp) override;

        /**
         * Get the table walker port. This is used for
         * migrating port connections during a CPU takeOverFrom()
         * call. For architectures that do not have a table walker,
         * NULL is returned, hence the use of a pointer rather than a
         * reference. For X86 this method will always return a valid
         * port pointer.
         *
         * @return A pointer to the walker port
         */
        Port *getTableWalkerPort() override;
    };

} // namespace X86ISA
} // namespace gem5

#endif // __ARCH_X86_TLB_HH__
