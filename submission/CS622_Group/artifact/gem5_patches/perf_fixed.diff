+// FIX(bug2/PERF_FIX_L2_FLUSH_NONGLOB): drop every non-global 4K sub-page from
+// every L2 region, mirroring what flushNonGlobal() already did for L1. The
+// original code left flushNonGlobal() as an L1-only operation, so on a CR3
+// (context) switch the new address space's accesses could still hit stale
+// L2 state left behind by the previous one.
+void TLB::l2_flushNonGlobal() {
+    static const bool fixFlush = perfFixEnabled("PERF_FIX_L2_FLUSH_NONGLOB");
+    if (!fixFlush)
+        return;
+    uint32_t pagesPerChunk = 512 / numCoarseChunks;
+    for (uint32_t s = 0; s < numL2Sets; s++) {
+        for (uint32_t w = 0; w < numL2Ways; w++) {
+            if (!l2_sets[s].valid[w])
+                continue;
+            SparseL2Entry &e = l2_sets[s].entries[w];
+            for (uint32_t chunk = 0; chunk < numCoarseChunks; chunk++) {
+                if (e.coarse_filter[chunk] == COARSE_EMPTY)
+                    continue;
+                int count = 0;
+                uint32_t start_idx = chunk * pagesPerChunk;
+                for (uint32_t k = start_idx; k < start_idx + pagesPerChunk; k++) {
+                    if (e.sub_valid[k] && !e.page_global[k])
+                        e.sub_valid[k] = false;
+                    if (e.sub_valid[k]) count++;
+                }
+                e.coarse_filter[chunk] =
+                    (count == 0) ? COARSE_EMPTY :
+                    ((uint32_t)count == pagesPerChunk) ? COARSE_CLEAN : COARSE_HOLEY;
+            }
+        }
+    }
