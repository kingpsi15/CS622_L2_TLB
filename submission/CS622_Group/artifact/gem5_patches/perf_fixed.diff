+// FIX(bug1/PERF_FIX_L2_DEMAP): clear the single 4KB sub-page (and recompute
+// the coarse filter for its chunk) in whichever L2 region matches va+pcid.
+// The original code had no equivalent of this at all: demapPage() touched
+// only the L1 trie, so a demapped-then-remapped VA could be served a stale
+// physical address straight out of the L2 on the very next access.
+void TLB::l2_demapPage(Addr va, uint64_t pcid) {
+    static const bool fixDemap = perfFixEnabled("PERF_FIX_L2_DEMAP");
+    static const bool fixPcid = perfFixEnabled("PERF_FIX_L2_PCID");
+    if (!fixDemap)
+        return;
+    Addr clean_va = va & ~((Addr)0xFFF);
+    Addr vpn_2mb = clean_va >> 21;
+    uint32_t set_idx = xor_7_hash(vpn_2mb);
+    uint32_t offset_4k = (clean_va >> X86ISA::PageShift) & 0x1FF;
+    uint32_t pagesPerChunk = 512 / numCoarseChunks;
+    uint32_t coarse_idx = offset_4k / pagesPerChunk;
+    for (uint32_t i = 0; i < numL2Ways; i++) {
+        if (l2_sets[set_idx].valid[i] && l2_sets[set_idx].entries[i].vpn_2mb == vpn_2mb &&
+            (!fixPcid || l2_sets[set_idx].entries[i].pcid == pcid)) {
+            if (!l2_sets[set_idx].entries[i].sub_valid[offset_4k])
+                continue;
+            l2_sets[set_idx].entries[i].sub_valid[offset_4k] = false;
+            int count = 0;
+            uint32_t start_idx = coarse_idx * pagesPerChunk;
+            for (uint32_t k = start_idx; k < start_idx + pagesPerChunk; k++)
+                if (l2_sets[set_idx].entries[i].sub_valid[k]) count++;
+            l2_sets[set_idx].entries[i].coarse_filter[coarse_idx] =
+                (count == 0) ? COARSE_EMPTY : COARSE_HOLEY;
+            DPRINTF(TLB, "SHP demap: cleared %#x from 2MB region %#x\n",
+                    clean_va, vpn_2mb << 21);
+        }
+    }
+}
