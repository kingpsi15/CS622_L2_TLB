+    for (uint32_t i = 0; i < l2NumWays; i++) {
+        if (l2_valid[base + i] && l2_entries[base + i].vaddr == concat_va) {
+            return &l2_entries[base + i];
+        }
+    }
+
+    // Pick a victim way according to the configured replacement policy.
+    uint32_t victim = 0;
+    bool foundEmpty = false;
+    for (uint32_t i = 0; i < l2NumWays && !foundEmpty; i++) {
+        if (!l2_valid[base + i]) { victim = i; foundEmpty = true; }
+    }
+    if (!foundEmpty) {
