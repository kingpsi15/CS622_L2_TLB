+uint32_t
+chkRandU32()
+{
+    static std::mt19937 rng(0xC0FFEE ^ (uint32_t)(uintptr_t)&rng);
+    return rng();
+}
+
+uint32_t
+envU32(const char *name, uint32_t def)
+{
+    if (const char *s = std::getenv(name)) {
+        char *end;
+        errno = 0;
+        unsigned long v = strtoul(s, &end, 0);
+        if (errno == ERANGE || end == s || *end != '\0' ||
+            v > std::numeric_limits<uint32_t>::max()) {
+            fatal("%s=%s must be an unsigned 32-bit integer\n", name, s);
+        }
+        return (uint32_t)v;
+    }
+    return def;
+}
+
+uint32_t
+roundUpPow2(uint32_t v)
+{
+    uint32_t p = 1;
+    while (p < v) p <<= 1;
+    return p;
+}
