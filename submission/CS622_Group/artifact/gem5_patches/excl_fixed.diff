+          case 1: { // FIFO: smallest insertion sequence number
+            victim = 0;
+            for (uint32_t i = 1; i < l2NumWays; i++)
+                if (l2_fifoSeq[base + i] < l2_fifoSeq[base + victim])
+                    victim = i;
+            break;
+          }
+          case 2: { // random
