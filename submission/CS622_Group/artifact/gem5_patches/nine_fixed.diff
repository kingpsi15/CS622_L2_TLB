+                l2_fifoSeq[slot] = fifoSeq;
+            }
+        }
+    }
+    // else: geometry changed across the restore (e.g. a different
+    // NINE_L2_SETS/WAYS); the L2 contents cannot be mapped 1:1 onto the new
+    // geometry, so we conservatively leave it empty rather than guess.
 }
 
